<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Math Ascension — Math RPG</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #0a1020;
            --panel: #141e33;
            --panel2: #0e1729;
            --line: #2a3a58;
            --text: #edf3ff;
            --muted: #9baccc;
            --mint: #72e0c1;
            --blue: #8baeff;
            --gold: #ffd37c;
            --red: #ff8d9d
        }
        body { --sf0: color-mix(in srgb, var(--panel) 62%, #000); --sf1: color-mix(in srgb, var(--panel) 80%, #000); --sf2: color-mix(in srgb, var(--panel) 82%, var(--line)); --sf3: color-mix(in srgb, var(--panel) 62%, var(--line)); --sfa: color-mix(in srgb, var(--panel) 78%, var(--mint)); }


        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: radial-gradient(ellipse at top, var(--sf2) 0, var(--sf0) 58%);
            font: 15px/1.45 system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            color: var(--text)
        }

        .wrap {
            max-width: 1250px;
            margin: auto;
            padding: 22px
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px
        }

        .logo {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--mint), var(--blue));
            color: #10182b;
            font-size: 25px;
            font-weight: 900
        }

        h1 {
            font-size: clamp(23px, 3vw, 32px);
            margin: 0;
            letter-spacing: -.8px
        }

        .sub {
            color: var(--muted);
            margin-top: 3px
        }

        .save {
            font-size: 12px;
            color: var(--mint);
            border: 1px solid var(--line);
            padding: 7px 11px;
            border-radius: 999px
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 11px;
            margin-bottom: 14px
        }

        .stat,
        .panel {
            background: linear-gradient(180deg, color-mix(in srgb, var(--sf1) 98%, transparent), color-mix(in srgb, var(--sf1) 98%, transparent));
            border: 1px solid var(--line);
            border-radius: 15px
        }

        .stat {
            padding: 14px
        }

        .label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--muted)
        }

        .value {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: -.6px;
            margin: 3px 0
        }

        .hint {
            font-size: 12px;
            color: var(--muted)
        }

        .layout {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(340px, .9fr);
            gap: 14px;
            align-items: start
        }

        .stack {
            display: grid;
            gap: 14px
        }

        .panel {
            padding: 17px
        }

        .head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 13px
        }

        .head h2 {
            font-size: 16px;
            margin: 0
        }

        .head small {
            font-size: 11px;
            color: var(--muted)
        }

        button,
        input,
        select {
            font: inherit
        }
        [hidden] { display: none !important; }

        button {
            cursor: pointer;
            color: var(--text);
            background: var(--sf3);
            border: 1px solid #35496d;
            border-radius: 9px;
            padding: 9px 12px
        }

        button:hover {
            border-color: var(--blue);
            background: var(--sf3)
        }

        button:disabled {
            opacity: .4;
            cursor: not-allowed
        }

        .primary {
            background: linear-gradient(135deg, var(--mint), #7dcce9);
            border: 0;
            color: #0b1826;
            font-weight: 800
        }

        .primary:hover {
            background: linear-gradient(135deg, #9af0d8, #9bddf3)
        }

        .full {
            width: 100%
        }

        .types {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px
        }

        .type {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px;
            background: var(--sf1);
            border: 1px solid var(--line);
            border-radius: 10px;
            cursor: pointer
        }

        .type input {
            accent-color: var(--mint);
            width: 17px;
            height: 17px
        }

        .type.locked {
            opacity: .5;
            cursor: not-allowed
        }

        .type .tname {
            font-weight: 700;
            font-size: 13px
        }

        .type .tmeta {
            font-size: 11px;
            color: var(--muted)
        }

        .bonus {
            margin-top: 11px;
            background: var(--sf0);
            border: 1px solid #2a3d59;
            border-radius: 10px;
            padding: 10px;
            display: flex;
            justify-content: space-between;
            gap: 10px
        }

        .bonus strong {
            color: var(--gold)
        }

        .question-box {
            position: relative;
            padding: 20px 15px;
            border-radius: 13px;
            background: linear-gradient(140deg, var(--sf1), var(--sf2));
            border: 1px solid #304363;
            text-align: center
        }

        .qtype {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: var(--mint)
        }

        .question {
            font-size: clamp(31px, 5vw, 48px);
            font-weight: 850;
            letter-spacing: -1.4px;
            margin: 8px 0 14px;
            overflow-wrap: anywhere
        }

        .answerrow {
            display: flex;
            gap: 8px;
            max-width: 480px;
            margin: auto
        }

        .answerrow input {
            min-width: 0;
            flex: 1;
            background: #f5f8ff;
            color: #152039;
            border: 2px solid transparent;
            border-radius: 10px;
            padding: 13px 12px;
            font-size: 21px;
            font-weight: 700;
            text-align: center;
            outline: none
        }

        .answerrow input:focus {
            border-color: var(--mint)
        }

        .answerrow button {
            min-width: 105px
        }

        .feedback {
            min-height: 23px;
            margin-top: 10px;
            font-size: 13px;
            color: var(--muted)
        }

        .feedback.good {
            color: var(--mint)
        }

        .feedback.bad {
            color: var(--red)
        }
        .currency-stat .value { color: var(--gold) }
        .store-intro { color:var(--muted); font-size:12px; margin:0 0 12px; }
        .tree-viewport { overflow-x:auto; overflow-y:hidden; padding:4px 2px 14px; scroll-snap-type:x proximity; }
        .tree-columns { display:grid; grid-template-columns:repeat(11,minmax(350px,350px)); gap:12px; width:max-content; align-items:start; }
        .tree-branch { background:color-mix(in srgb, var(--sf1) 50%, transparent); border:1px solid var(--line); border-radius:13px; padding:10px; scroll-snap-align:start; }
        .branch-heading { min-height:74px; text-align:center; padding:9px 5px 12px; border-bottom:1px solid var(--line); margin-bottom:10px; }
        .branch-heading .branch-symbol { display:block; font-size:24px; font-weight:850; color:var(--mint); margin-bottom:3px; }
        .branch-heading h3 { font-size:14px; margin:0 0 5px; }
        .branch-heading p { font-size:10px; line-height:1.35; color:var(--muted); margin:0; }
        .branch-heading .branch-state { display:inline-block; margin-top:6px; font-size:9px; color:var(--gold); text-transform:uppercase; letter-spacing:.06em; }
        .branch-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); grid-template-rows:repeat(10,minmax(104px,auto)); gap:0 7px; position:relative; }
        .tree-cell { min-width:0; position:relative; display:flex; align-items:stretch; justify-content:center; padding:8px 0; }
        .tree-cell::before { content:""; position:absolute; top:0; bottom:0; left:50%; border-left:1px solid rgba(126,153,183,.18); z-index:0; }
        .tree-cell:nth-child(-n+3)::before { top:0; }
        .tree-node { position:relative; z-index:1; width:100%; min-width:0; padding:8px 6px; display:flex; flex-direction:column; gap:6px; border:1px solid var(--line); border-radius:10px; background:var(--sf1); box-sizing:border-box; }
        .tree-node h4 { font-size:11px; line-height:1.25; margin:0; overflow-wrap:anywhere; }
        .tree-node p { font-size:10px; line-height:1.35; color:var(--muted); margin:0; flex:1; overflow-wrap:anywhere; }
        .tree-node .cost { color:var(--gold); font-size:10px; font-weight:800; }
        .tree-node.owned { border-color:var(--mint); box-shadow:0 0 0 1px color-mix(in srgb, var(--mint) 12%, transparent); }
        .tree-node.enabled { background:linear-gradient(145deg,var(--sfa),var(--sf1)); }
        .tree-node.locked { opacity:.72; }
        .tree-node.future { min-height:64px; align-items:center; justify-content:center; border-style:dashed; background:color-mix(in srgb, var(--sf1) 35%, transparent); color:var(--muted); text-align:center; }
        .tree-node.future span { font-size:10px; line-height:1.3; }
        .tree-node .status-pill { font-size:8px; line-height:1.2; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
        .tree-node button { font-size:10px; padding:6px 4px; width:100%; margin-top:2px; }
        .tree-node .toggle { background:var(--sf2); }
        .branch-locked { filter:saturate(.55); }
        .branch-locked .branch-grid { opacity:.68; }
        .tree-legend { display:flex; flex-wrap:wrap; gap:12px; color:var(--muted); font-size:11px; margin:8px 0 12px; }
        .tree-legend span { display:flex; align-items:center; gap:5px; }
        .legend-dot { width:9px; height:9px; display:inline-block; border-radius:50%; background:var(--mint); }
        .legend-dot.locked-dot { background:#68758a; }
        .legend-dot.future-dot { border:1px dashed #68758a; background:transparent; }
        /* Branch button array: one button per branch; only the selected branch's tree is shown */
        .branch-buttons { margin:4px 0 14px; }
        .branch-group { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:8px; }
        .branch-group-title { font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin:12px 0 6px; }
        .branch-group-title:first-child { margin-top:0; }
        .branch-btn { display:flex; flex-direction:column; align-items:center; gap:2px; padding:10px 6px; border-radius:11px; background:var(--sf1); border:1px solid var(--line); text-align:center; }
        .branch-btn .bb-symbol { font-size:20px; font-weight:850; color:var(--mint); line-height:1.1; }
        .branch-btn .bb-label { font-size:12px; font-weight:700; }
        .branch-btn .bb-state { font-size:9px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
        .branch-btn.locked-branch { opacity:.6; }
        .branch-btn.active { border-color:var(--mint); background:linear-gradient(145deg,var(--sfa),var(--sf1)); box-shadow:0 0 0 1px color-mix(in srgb, var(--mint) 25%, transparent); }
        .branch-btn.active .bb-state { color:var(--gold); }
        #skillTree { display:block; }
        #skillTree .tree-branch { max-width:520px; margin:0 auto; }
        /* Daily (away) reward */
        .boost-bar { display:flex; flex-wrap:wrap; gap:8px; margin:-6px 0 14px; }
        .boost-bar:empty { display:none; }
        .boost-chip { font-size:12px; font-weight:700; color:#0b1826; background:linear-gradient(135deg,var(--gold),#ffb86b); padding:5px 11px; border-radius:999px; }
        .reward-overlay { position:fixed; inset:0; z-index:1000; display:grid; place-items:center; padding:18px; background:color-mix(in srgb, var(--sf1) 78%, transparent); backdrop-filter:blur(3px); }
        .reward-modal { width:100%; max-width:430px; text-align:center; padding:26px 22px 22px; background:linear-gradient(180deg,var(--sf2),var(--sf1)); border:1px solid var(--mint); border-radius:18px; box-shadow:0 18px 60px rgba(0,0,0,.55); }
        .reward-modal h2 { margin:0 0 4px; font-size:22px; letter-spacing:-.4px; }
        .question-box { position:relative; }
        .question-box .qtype { padding:0 66px; }
        .info-btn { position:absolute; top:10px; right:10px; width:28px; height:28px; padding:0; border-radius:50%; display:grid; place-items:center; font:italic 800 15px Georgia, "Times New Roman", serif; color:var(--mint); background:color-mix(in srgb, var(--mint) 8%, transparent); border:1.5px solid color-mix(in srgb, var(--mint) 55%, transparent); cursor:pointer; z-index:2; }
        .info-btn:hover, .info-btn:focus-visible { background:color-mix(in srgb, var(--mint) 20%, transparent); border-color:var(--mint); }
        .help-modal { position:relative; text-align:left; max-width:470px; }
        .help-kicker { font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--mint); margin-bottom:2px; }
        .help-modal h2 { font-size:22px; margin-bottom:8px; padding-right:30px; }
        .help-intro { color:#d6e2f5; margin:0 0 12px; line-height:1.45; }
        .help-sec { font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin:12px 0 6px; }
        .help-list { margin:0; padding-left:20px; display:grid; gap:6px; line-height:1.45; font-size:14px; }
        .help-ex { background:var(--sf0); border:1px solid var(--line); border-radius:10px; padding:10px 12px; font-size:14px; line-height:1.55; }
        .help-ex .ex-q { font-weight:800; margin-bottom:4px; }
        .help-ex .ex-s { color:#c9d6ea; }
        .help-ex .ex-s:last-child { color:var(--mint); font-weight:700; }
        .help-tip { margin-top:12px; padding:9px 12px; border-radius:10px; background:rgba(255,211,124,.08); border:1px solid rgba(255,211,124,.35); color:#ffe2a8; font-size:13px; line-height:1.45; }
        .help-close { position:absolute; top:12px; right:12px; width:32px; height:32px; padding:0; border-radius:50%; }
        .help-ok { width:100%; margin-top:16px; }
        .reward-away { color:var(--muted); font-size:13px; margin:0 0 16px; }
        .reward-card { background:var(--sf0); border:1px solid #2a3d59; border-radius:13px; padding:16px 12px; margin-bottom:16px; }
        .reward-icon { font-size:38px; line-height:1; margin-bottom:6px; }
        .reward-title { font-size:18px; font-weight:800; color:var(--gold); }
        .reward-desc { font-size:13px; color:var(--muted); margin-top:4px; }
        .reward-card.nothing .reward-title { color:var(--muted); }
        .header-right { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
        .reward-btn { position:relative; display:flex; align-items:center; gap:7px; padding:6px 11px; border-radius:999px; background:var(--sf1); border:1px solid var(--line); }
        .reward-btn-icon { font-size:18px; line-height:1; }
        .reward-btn-timer { font-size:11px; color:var(--muted); font-variant-numeric:tabular-nums; }
        .reward-btn.has-rewards { border-color:var(--gold); animation:rewardPulse 1.8s ease-in-out infinite; }
        .reward-btn.full .reward-btn-timer { color:var(--gold); font-weight:700; }
        .reward-badge { position:absolute; top:-7px; right:-5px; min-width:19px; height:19px; padding:0 5px; border-radius:999px; background:var(--gold); color:#0b1826; font-size:11px; font-weight:800; display:grid; place-items:center; }
        @keyframes rewardPulse { 0%,100% { box-shadow:0 0 0 0 rgba(255,211,124,.45) } 50% { box-shadow:0 0 0 6px rgba(255,211,124,0) } }
        .reward-row { display:flex; justify-content:space-between; gap:10px; padding:7px 4px; font-size:14px; text-align:left; border-bottom:1px solid #1c2a44; }
        .reward-row:last-child { border-bottom:0; }
        .reward-row strong { color:var(--gold); white-space:nowrap; }
        .reward-empty { color:var(--muted); font-size:14px; padding:6px 0; }
        .reward-close { margin-top:8px; }
        .debug-wrap { position:fixed; left:14px; bottom:14px; z-index:900; display:flex; flex-direction:column; align-items:flex-start; gap:8px; }
        .debug-toggle { width:38px; height:38px; padding:0; border-radius:50%; opacity:.6; }
        .debug-toggle:hover { opacity:1; }
        .debug-panel .dbg-on { background:var(--mint); color:#04121f; border-color:var(--mint); }
        .debug-panel { display:grid; gap:7px; padding:12px; min-width:190px; background:var(--sf1); border:1px solid var(--line); border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,.5); }
        .variety-chip { flex:none; padding:5px 11px; border-radius:999px; background:#1c1806; border:1px solid var(--gold); color:var(--gold); font-weight:800; font-size:12px; white-space:nowrap; }
        .pk-subject { scroll-margin-top:calc(var(--m-top, 0px) + 10px); }
        .subject-jump { display:flex; gap:6px; flex-wrap:wrap; margin:2px 0 10px; }
        .subject-jump button { padding:6px 12px; border-radius:999px; background:var(--sf1); border:1px solid var(--line); font-size:13px; font-weight:700; }
        .subject-jump .notif-dot { margin-left:6px; }
        .diff-limit.compact { padding:8px 10px; }
        .diff-limit.compact .diff-row { margin-top:0; gap:10px; }
        .diff-lab { flex:none; padding:0; background:none; border:0; color:var(--muted); font-size:12px; font-weight:700; white-space:nowrap; text-decoration:underline dotted; text-underline-offset:3px; }
        .notice-bar { position:fixed; left:50%; top:calc(var(--m-top, 0px) + 8px); z-index:948; width:min(440px, calc(100vw - 24px)); display:flex; align-items:center; gap:10px; padding:9px 14px; border-radius:12px; background:linear-gradient(90deg,var(--sfa),var(--panel)); border:1px solid var(--mint); box-shadow:0 8px 24px rgba(0,0,0,.45); color:var(--text); font-size:13px; text-align:left; opacity:0; visibility:hidden; pointer-events:none; transform:translate(-50%,-40px); transition:transform .35s cubic-bezier(.2,1.2,.4,1), opacity .25s, visibility 0s .35s; }
        .notice-bar.show { opacity:1; visibility:visible; pointer-events:auto; transform:translate(-50%,0); transition:transform .35s cubic-bezier(.2,1.2,.4,1), opacity .25s, visibility 0s; }
        .notice-bar .nb-ic { font-size:18px; }
        .notice-bar .nb-tx { flex:1; min-width:0; }
        .notice-bar .nb-go { color:var(--mint); font-size:20px; font-weight:800; }
        .game-menu button.bg-run strong::after { content:" · auto 25%"; font-size:10px; font-weight:700; color:var(--mint); }
        .game-switch button.bg-run::after { content:" ↻"; color:var(--mint); }
        .away-ic { font-size:44px; line-height:1; }
        .away-bg { color:var(--mint); font-size:10px; font-weight:700; }
        .away-total { border-top:1px solid var(--line); margin-top:4px; padding-top:8px; font-weight:800; }
        .diff-limit { margin-top:11px; background:var(--sf0); border:1px solid #2a3d59; border-radius:10px; padding:10px; }
        .diff-head { display:flex; justify-content:space-between; align-items:baseline; gap:10px; }
        .diff-head strong:last-child { color:var(--gold); }
        .diff-row { display:flex; align-items:center; gap:12px; margin-top:8px; }
        .diff-row input[type=range] { flex:1; accent-color:var(--mint); min-width:0; }
        .diff-row input[type=number] { width:68px; padding:6px 8px; border-radius:8px; background:var(--sf1); color:var(--text); border:1px solid var(--line); }
        .daily-btn { display:flex; align-items:center; gap:5px; padding:6px 11px; border-radius:999px; background:var(--sf1); border:1px solid var(--line); font-weight:800; font-size:13px; }
        .daily-btn svg, .m-daily svg { width:15px; height:15px; color:var(--gold); flex:none; }
        .daily-btn.active, .m-daily.active { border-color:rgba(255,211,124,.55); }
        .daily-ladder { display:grid; gap:6px; margin-bottom:14px; text-align:left; }
        .daily-day { display:grid; grid-template-columns:48px 1fr 22px; align-items:center; gap:8px; padding:7px 10px; border-radius:9px; background:var(--sf0); border:1px solid #1c2a44; font-size:13px; color:var(--muted); }
        .daily-day.on { color:var(--text); border-color:color-mix(in srgb, var(--mint) 35%, transparent); }
        .daily-day.now { border-color:var(--gold); background:var(--sf2); }
        .daily-day .dd-n { font-weight:800; }
        .daily-day .dd-s { text-align:right; }
        .mods-btn { padding:6px 11px; font-size:12px; border-radius:999px; white-space:nowrap; }
        .mods-modal { max-width:520px; text-align:left; position:relative; padding:22px 18px 18px; }
        .mods-modal h2, .mods-modal .reward-away { text-align:center; }
        .mods-x { position:absolute; top:10px; right:10px; width:32px; height:32px; padding:0; border-radius:50%; font-size:14px; }
        .md-sec { font-size:11px; text-transform:uppercase; letter-spacing:.07em; color:var(--mint); margin:14px 0 4px; }
        .md-row { padding:8px 2px; border-bottom:1px solid #1c2a44; }
        .md-row:last-child { border-bottom:0; }
        .md-top { display:flex; justify-content:space-between; align-items:baseline; gap:10px; font-size:14px; }
        .md-top strong { color:var(--gold); white-space:nowrap; }
        .md-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:4px; margin-top:5px; }
        .md-grid span { background:var(--sf0); border:1px solid #22324e; border-radius:8px; padding:4px 2px; text-align:center; font-size:11px; color:var(--muted); line-height:1.25; }
