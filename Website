            function goToChoose() {
                if (isMobile()) setMobileView("settings");
                else $("panelChoose").scrollIntoView({ behavior: "smooth", block: "center" });
            }
            function checkUnlocks() {
                const shown = TOPICS.filter(topicRevealed).map(t => t.id), newTopics = [];
                if (!Array.isArray(state.topicsSeen)) state.topicsSeen = shown.slice();
                else shown.filter(id => !state.topicsSeen.includes(id)).forEach(id => { newTopics.push(id); const t = topicById(id); state.topicsSeen.push(id); scheduleSave(); showToast("\ud83d\udd0d", `${t.symbol} ${t.name} unlocked!`, t.desc + ". Open it in Choose what to practice.", goToChoose); });
                const open = unlockedDefs();
                if (!Array.isArray(state.announced)) { state.announced = open.map(d => d.id); state.newSkills = []; return; }   // saves from before this feature: nothing is "new"
                const added = open.filter(d => !state.announced.includes(d.id));
                const before = (state.newSkills || []).join();
                state.newSkills = (state.newSkills || []).filter(id => state.types[id] && !state.types[id].enabled);   // toggling a skill on clears its marker
                added.forEach(d => {
