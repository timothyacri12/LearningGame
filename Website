            const HELP = {"add": ["Addition combines amounts into a total.", ["Line up the place values: ones under ones, tens under tens.", "Add from right to left. If a column reaches 10 or more, carry 1 to the next column.", "Order doesn't matter: 7 + 5 = 5 + 7."], ["47 + 38", "Ones: 7 + 8 = 15 → write 5, carry 1", "Tens: 4 + 3 + 1 = 8", "Answer: 85"], "Round to check: 50 + 40 = 90, so 85 is reasonable."], "sub": ["Subtraction finds the difference between two numbers.", ["Line up place values and subtract right to left.", "If the top digit is smaller, borrow 1 from the next column (worth 10 here).", "Check by adding: difference + smaller number = bigger number."], ["82 − 47", "Ones: 2 < 7, borrow → 12 − 7 = 5", "Tens: 7 − 4 = 3", "Answer: 35 (check: 35 + 47 = 82)"], null], "mul": ["Multiplication is repeated addition: 4 × 6 means four groups of 6.", ["Know your times tables up to 12 × 12. They power everything else.", "Split big numbers: 7 × 23 = 7 × 20 + 7 × 3.", "Order doesn't matter: 3 × 8 = 8 × 3."], ["14 × 6", "10 × 6 = 60", "4 × 6 = 24", "60 + 24 = 84"], "Multiplying by 5? Multiply by 10 and halve it."], "div": ["Division splits a number into equal groups. It undoes multiplication.", ["Ask: what times the divisor gives the number? 56 ÷ 8 → 8 × ? = 56.", "Break big numbers into friendly chunks: 96 ÷ 4 = 80 ÷ 4 + 16 ÷ 4.", "Check by multiplying the answer back."], ["144 ÷ 6", "120 ÷ 6 = 20", "24 ÷ 6 = 4", "20 + 4 = 24"], null], "frac": ["Fractions are parts of a whole: top = parts you have, bottom = parts in the whole.", ["To add or subtract, the bottoms (denominators) must match.", "Find a common denominator, convert each fraction, then add/subtract the tops.", "Simplify at the end by dividing top and bottom by their greatest common factor."], ["1/4 + 2/3", "Common denominator 12: 3/12 + 8/12", "Add the tops: 11/12", "Already simplest → 11/12"], "Never add the denominators: 1/2 + 1/2 is 1, not 2/4."], "percent": ["Percent means \"per hundred\": 25% = 25/100 = 0.25.", ["X% of N = (X ÷ 100) × N.", "10% is easy: move the decimal one place left. Build other percents from it.", "50% = half, 25% = a quarter, 75% = three quarters."], ["15% of 80", "10% of 80 = 8", "5% = half of that = 4", "8 + 4 = 12"], null], "powers": ["A power is repeated multiplication; a square root undoes squaring.", ["aⁿ = a multiplied by itself n times: 2⁴ = 2·2·2·2 = 16.", "x² means x × x. Memorize squares up to 15² = 225.", "√n asks: what number squared gives n? √81 = 9."], ["3⁴", "3 × 3 = 9", "9 × 3 = 27", "27 × 3 = 81"], "2⁴ is not 2 × 4. Exponents multiply the base by itself."], "mixed": ["Order of operations tells you what to do first.", ["Parentheses first.", "Then exponents.", "Then multiplication and division (left to right).", "Then addition and subtraction (left to right)."], ["4 + 3 × 5", "Multiply first: 3 × 5 = 15", "Then add: 4 + 15 = 19", "(Not 7 × 5 = 35!)"], "Memory aid: PEMDAS (Please Excuse My Dear Aunt Sally)."], "logs": ["A logarithm asks: what power do I raise the base to? log₂(8) = 3 because 2³ = 8.", ["Product: log(a) + log(b) = log(a·b)", "Quotient: log(a) − log(b) = log(a/b)", "Power: n·log(a) = log(aⁿ)", "Undo: b^(log_b x) = x and log_b(bⁿ) = n. Also log_b(b) = 1, log_b(1) = 0."], ["log(3) + log(3)", "Same as 2·log(3)", "Power rule: = log(3²)", "= log(9)"], "log with no base means base 10."], "alg1": ["Solve for x by undoing the one thing done to it.", ["Do the opposite operation to both sides.", "+ ↔ −, × ↔ ÷", "Whatever you do to one side, do to the other."], ["x + 7 = 12", "Undo +7: subtract 7 from both sides", "x = 12 − 7", "x = 5"], "Check by plugging back in: 5 + 7 = 12 ✓"], "alg2": ["Two operations were done to x. Undo them in reverse order.", ["First undo the + or − (the constant).", "Then undo the × or ÷ (the coefficient).", "Keep both sides balanced."], ["3x − 4 = 11", "Add 4: 3x = 15", "Divide by 3: x = 5", "Check: 3·5 − 4 = 11 ✓"], null], "alg3": ["Simplify by combining like terms and distributing.", ["Like terms have the same variable part: 3x and −5x combine; 3x and 3 don't.", "Distribute: a(b + c) = ab + ac.", "A minus in front of parentheses flips every sign inside."], ["2(x + 3) − 5x + 1", "Distribute: 2x + 6 − 5x + 1", "Combine x terms: 2x − 5x = −3x", "Combine numbers: 6 + 1 = 7 → −3x + 7"], null], "alg4": ["Get all the x terms on one side and the numbers on the other.", ["Subtract the smaller x term from both sides.", "Move the constants to the other side.", "Divide by the remaining coefficient."], ["5x + 2 = 2x + 14", "Subtract 2x: 3x + 2 = 14", "Subtract 2: 3x = 12", "Divide by 3: x = 4"], null], "alg7": ["Solve inequalities like equations, with one twist.", ["Add, subtract, multiply and divide both sides as usual.", "Multiplying or dividing by a NEGATIVE flips the sign: < becomes >.", "Compound a < x + b < c: do the same thing to all three parts.", "|x − c| < r means c − r < x < c + r; |x − c| > r means x < c − r or x > c + r."], ["−2x + 3 > 11", "Subtract 3: −2x > 8", "Divide by −2 and flip: x < −4", ""], "≥ and ≤ include the endpoint; > and < don't."], "alg8": ["A line can be written y = mx + b: m is the slope, b is the y-intercept.", ["Slope = rise over run = (y₂ − y₁) / (x₂ − x₁).", "b is where the line crosses the y-axis (when x = 0).", "Find b from a point: plug x and y into y = mx + b and solve.", "x-intercept: set y = 0. Perpendicular slopes are negative reciprocals (2 → −1/2)."], ["Line through (1, 5) and (3, 9)", "m = (9 − 5)/(3 − 1) = 2", "5 = 2·1 + b → b = 3", "y = 2x + 3"], null], "alg9": ["A system is two equations that share a solution (x, y), where the lines cross.", ["Substitution: solve one equation for a variable, plug it into the other.", "Elimination: add or subtract the equations to cancel a variable.", "Same slope, different intercept: no solution. Same line: infinitely many solutions."], ["x + y = 10 and x − y = 4", "Add them: 2x = 14 → x = 7", "Plug in: 7 + y = 10 → y = 3", "Answer: (7, 3)"], null], "alg10": ["Exponent rules and polynomial arithmetic.", ["Multiply: add exponents (x³·x⁴ = x⁷). Divide: subtract (x⁵ ÷ x² = x³).", "Power of a power: multiply (x²)³ = x⁶. x⁰ = 1, x⁻ⁿ = 1/xⁿ.", "Add/subtract polynomials: combine like terms.", "Multiply binomials with FOIL: First, Outer, Inner, Last."], ["(x + 3)(x − 5)", "F: x·x = x²   O: −5x   I: 3x   L: −15", "Combine: x² − 2x − 15", ""], "(x + a)² = x² + 2ax + a², not x² + a²."], "alg5": ["Factoring rewrites an expression as a product, which is the reverse of multiplying out.", ["Always pull out the greatest common factor first: 6x² + 9x = 3x(2x + 3).", "x² + bx + c: find two numbers that multiply to c and add to b.", "Difference of squares: a² − b² = (a − b)(a + b)."], ["x² + 7x + 12", "Need: multiply to 12, add to 7", "3 and 4 work", "(x + 3)(x + 4)"], "Check by multiplying the factors back out."], "alg6": ["Solve ax² + bx + c = 0. There are usually two answers.", ["Factor, then set each factor to 0 (zero-product rule).", "x² = k → x = ±√k.", "Quadratic formula works every time: x = (−b ± √(b² − 4ac)) / 2a."], ["x² − x − 6 = 0", "Factor: (x − 3)(x + 2) = 0", "x − 3 = 0 → x = 3", "x + 2 = 0 → x = −2"], null], "alg11": ["Simplify square roots and fractions that contain x.", ["√(a·b) = √a·√b. Pull out perfect squares: √50 = √25·√2 = 5√2.", "Only like radicals add: 2√3 + 5√3 = 7√3.", "Rationalize: multiply top and bottom by the root, so 6/√3 = 6√3/3 = 2√3.", "Rational expressions: factor top and bottom, then cancel common factors."], ["(x² − 9)/(x + 3)", "Factor top: (x − 3)(x + 3)", "Cancel (x + 3)", "= x − 3"], null], "geo1": ["Perimeter is the distance around a shape; area is the space inside.", ["Rectangle: P = 2(l + w), A = l·w. Square: P = 4s, A = s².", "Triangle: A = ½·base·height.", "Parallelogram: A = base·height. Trapezoid: A = ½(b₁ + b₂)·h."], ["Trapezoid, bases 6 and 10, height 4", "Add bases: 6 + 10 = 16", "Half of 16 = 8", "8 × 4 = 32"], "Cutting a corner out of a rectangle lowers the area, but the perimeter stays the same."], "geo2": ["Angles have rules for how they relate to each other.", ["Complementary angles add to 90°; supplementary add to 180°. Vertical angles are equal.", "Parallel lines + transversal: corresponding and alternate interior angles are equal; same-side interior add to 180°.", "Triangle angles add to 180°. An exterior angle equals the two remote interior angles added.", "Polygon interior sum = (n − 2)·180°. A regular n-gon's exterior angle = 360°/n."], ["Triangle with 50° and 65°", "50 + 65 = 115", "180 − 115 = 65", "Third angle: 65°"], null], "geo3": ["In a right triangle, the legs a and b and the hypotenuse c satisfy a² + b² = c².", ["Missing hypotenuse: c = √(a² + b²). Missing leg: b = √(c² − a²).", "Common triples: 3-4-5, 5-12-13, 8-15-17 (and multiples).", "45-45-90: hypotenuse = leg·√2. 30-60-90: sides x, x√3, 2x.", "Compare c² with a² + b² (c longest): equal → right, less → acute, more → obtuse. The third side must lie between the difference and the sum of the other two."], ["Legs 6 and 8", "6² + 8² = 36 + 64 = 100", "c = √100", "c = 10"], null], "geo4": ["Circle formulas use the radius r (center to edge). The diameter d = 2r.", ["Circumference C = 2πr = πd. Area A = πr².", "Arc length = (angle/360)·2πr. Sector area = (angle/360)·πr².", "An inscribed angle is half its intercepted arc."], ["Sector of 90°, radius 6", "90/360 = 1/4", "π·6² = 36π", "¼ of 36π = 9π"], "Answers \"in terms of π\" keep π as a symbol: 36π, not 113.1."], "geo5": ["Volume is the space inside a solid; surface area is the total area of its outside.", ["Box: V = l·w·h, SA = 2(lw + lh + wh). Cube: V = s³, SA = 6s².", "Cylinder: V = πr²h, SA = 2πr² + 2πrh.", "Cone and pyramid: ⅓ of the matching prism. Cone V = ⅓πr²h.", "Sphere: V = ⁴⁄₃πr³, SA = 4πr²."], ["Cylinder r = 3, h = 5", "r² = 9", "9 × 5 = 45", "V = 45π"], null], "geo6": ["Similar shapes have the same shape but different size. All lengths scale by the same factor k.", ["Scale factor k = new length ÷ old length.", "Set up a proportion with matching sides: a/b = c/d, then cross-multiply.", "Areas scale by k², volumes by k³."], ["Sides 4 and 6; the similar shape has 10 for the 4", "k = 10 ÷ 4 = 2.5", "Other side: 6 × 2.5", "= 15"], "Multiply, don't add: growing 4 → 10 is ×2.5, not +6."], "geo7": ["Points on a grid are (x, y). Many geometry ideas become arithmetic.", ["Distance = √((x₂ − x₁)² + (y₂ − y₁)²), which is Pythagoras on the grid.", "Midpoint = ((x₁ + x₂)/2, (y₁ + y₂)/2).", "Reflections: over the x-axis (x, −y); over the y-axis (−x, y); over y = x (y, x).", "Rotations about the origin: 90° counterclockwise (−y, x); 180° (−x, −y). Circle: (x − h)² + (y − k)² = r²."], ["Distance from (1, 2) to (4, 6)", "Δx = 3, Δy = 4", "√(9 + 16) = √25", "= 5"], null], "geo8": ["SOH CAH TOA connects an angle of a right triangle to its side ratios.", ["sin = opposite/hypotenuse, cos = adjacent/hypotenuse, tan = opposite/adjacent.", "Missing side: pick the ratio that uses the side you know and the side you want.", "Missing angle: use inverse trig (sin⁻¹, cos⁻¹, tan⁻¹).", "Exact values: sin 30° = 1/2, sin 45° = √2/2, sin 60° = √3/2, tan 45° = 1."], ["Hypotenuse 10, angle 30°, find the opposite side", "sin 30° = opp/10", "opp = 10 × sin 30°", "= 10 × 0.5 = 5"], "Your calculator must be in degree mode for these."], "geo9": ["Radians measure angles by arc length: a full circle is 2π radians = 360°.", ["Degrees → radians: × π/180. Radians → degrees: × 180/π.", "On the unit circle, a point is (cos θ, sin θ).", "Reference angle: the acute angle to the x-axis. Signs by quadrant: I all +, II sin +, III tan +, IV cos +.", "Coterminal angles differ by 360°. Arc length s = rθ (θ in radians)."], ["sin(150°)", "Quadrant II: sin is positive", "Reference angle: 180 − 150 = 30°", "sin 30° = 1/2 → answer 1/2"], "Memory aid for the quadrant signs: All Students Take Calculus."], "geo10": ["Trig identities are always-true equations; the laws of sines and cosines solve any triangle.", ["sin²θ + cos²θ = 1 and tan θ = sin θ / cos θ.", "Double angle: sin 2θ = 2 sin θ cos θ, cos 2θ = cos²θ − sin²θ.", "Law of sines: a/sin A = b/sin B = c/sin C.", "Law of cosines: c² = a² + b² − 2ab·cos C. Triangle area = ½ab·sin C."], ["sin θ = 3/5, θ in Quadrant II, find cos θ", "cos²θ = 1 − 9/25 = 16/25", "cos θ = ±4/5", "Quadrant II: cos is negative → −4/5"], null]};   // concept id -> [intro, key ideas, worked example (problem, steps...), tip]
            Object.assign(HELP, {"chem1": ["Every element has a one- or two-letter symbol. The first letter is always uppercase, the second lowercase.", ["Most symbols come from the English name: C = carbon, O = oxygen, Ca = calcium.", "Some come from Latin: Na (natrium) = sodium, K (kalium) = potassium, Fe (ferrum) = iron.", "More Latin ones: Cu = copper, Ag = silver, Au = gold, Pb = lead, Sn = tin, Hg = mercury.", "Capitals matter: Co is cobalt, but CO is carbon monoxide."], ["Symbol for potassium?", "Not P (phosphorus) or Po (polonium)", "Latin name: kalium", "Answer: K"], "Learn the Latin-based symbols first. They're the ones that trip people up."], "chem2": ["Atoms are made of protons (+), neutrons (0) and electrons (−). The nucleus holds the protons and neutrons.", ["Atomic number = number of protons. It decides which element the atom is.", "Mass number = protons + neutrons, so neutrons = mass number − atomic number.", "A neutral atom has as many electrons as protons. Ions: + means electrons lost, − means electrons gained.", "Shells fill 2, then 8, then 8 (for the first 20 elements). Valence electrons are the ones in the outer shell."], ["Neutrons in chlorine-37 (atomic number 17)?", "Mass number = 37", "Protons = 17", "Neutrons = 37 − 17 = 20"], "Isotopes of an element have the same protons but different neutrons."], "chem3": ["The periodic table is ordered by atomic number. Rows are periods; columns are groups with similar properties.", ["Group 1 = alkali metals, 2 = alkaline earth metals, 17 = halogens, 18 = noble gases (unreactive).", "Metals are on the left, nonmetals on the right, metalloids along the staircase.", "Going across a period: radius shrinks, while electronegativity and ionization energy rise.", "Going down a group: radius grows, while electronegativity and ionization energy fall."], ["Larger atom: sodium or chlorine?", "Same period (row 3)", "Sodium is further left", "Fewer protons pull less → sodium is larger"], "Fluorine (top right, not counting noble gases) is the most electronegative element."], "chem4": ["Atoms bond by transferring electrons (ionic) or sharing them (covalent).", ["Metals lose electrons → + ions (Na⁺, Ca²⁺, Al³⁺). Nonmetals gain them → − ions (Cl⁻, O²⁻, N³⁻).", "Ionic formula: make the charges cancel. Ca²⁺ and Cl⁻ → CaCl₂.", "Naming ionic compounds: metal name + nonmetal root + \"-ide\": sodium chloride.", "Covalent (two nonmetals) names use prefixes: mono-, di-, tri-, tetra-, penta-, hexa-. CO₂ = carbon dioxide."], ["Formula for aluminum oxide?", "Ions: Al³⁺ and O²⁻", "Charges must cancel: 2 × (+3) = 3 × (−2)", "Al₂O₃"], "Polyatomic ions stay together in parentheses: Ca(OH)₂, (NH₄)₂SO₄."], "chem5": ["A mole is a counting unit: 1 mol = 6.02 × 10²³ particles (Avogadro's number).", ["Molar mass (g/mol) = sum of the atomic masses in the formula.", "Moles = mass ÷ molar mass; mass = moles × molar mass.", "Particles = moles × 6.02 × 10²³.", "Mass % of an element = (its mass in the formula ÷ molar mass) × 100."], ["Moles in 88 g of CO₂? (C = 12, O = 16)", "Molar mass = 12 + 2 × 16 = 44 g/mol", "Moles = 88 ÷ 44", "= 2 mol"], "Multiply each atomic mass by its subscript: H₂O is 2 × 1 + 16, not 1 + 16."], "chem6": ["Atoms aren't created or destroyed, so each element must appear the same number of times on both sides.", ["Only change the coefficients (big numbers in front). Never change subscripts.", "Balance one element at a time; leave H and O for last.", "Use the smallest whole-number coefficients.", "Count atoms: coefficient × subscript. 3 Ca(NO₃)₂ has 3 × 2 × 3 = 18 O atoms."], ["Balance: H₂ + O₂ → H₂O", "O: 2 on the left, 1 on the right → put 2 in front of H₂O", "H: now 4 on the right → put 2 in front of H₂", "2 H₂ + O₂ → 2 H₂O"], null], "chem7": ["Most reactions fit a few patterns. Spot the pattern to name the type.", ["Synthesis: A + B → AB. Decomposition: AB → A + B.", "Single replacement: A + BC → AC + B. Double replacement: AB + CD → AD + CB.", "Combustion: fuel + O₂ → CO₂ + H₂O. Neutralization: acid + base → salt + water.", "Exothermic releases heat; endothermic absorbs it. Catalysts speed reactions without being used up."], ["2 KClO₃ → 2 KCl + 3 O₂", "One reactant", "Breaks into two products", "Decomposition"], "Oxidation Is Loss, Reduction Is Gain (of electrons): OIL RIG."], "chem8": ["Stoichiometry uses the coefficients of a balanced equation as mole ratios.", ["Mole ratio: in 2 H₂ + O₂ → 2 H₂O, 2 mol H₂ make 2 mol H₂O.", "Grams → moles (÷ molar mass) → mole ratio → moles → grams (× molar mass).", "Molarity M = moles of solute ÷ liters of solution. Dilution: M₁V₁ = M₂V₂.", "Percent yield = actual ÷ theoretical × 100. The limiting reactant runs out first."], ["N₂ + 3 H₂ → 2 NH₃: NH₃ from 6 mol H₂?", "Ratio H₂ : NH₃ = 3 : 2", "6 mol H₂ × (2 ÷ 3)", "= 4 mol NH₃"], "Always convert grams to moles before using the ratio."], "chem9": ["pH measures acidity: below 7 is acidic, 7 is neutral, above 7 is basic.", ["pH = −log[H⁺]. If [H⁺] = 1 × 10⁻ⁿ M, then pH = n.", "pH + pOH = 14.", "Each pH step is 10× in [H⁺]: pH 3 is 100× more acidic than pH 5.", "Acids donate H⁺ (sour, turn litmus red); bases accept H⁺ or give OH⁻ (bitter, slippery)."], ["pH of 0.001 M HCl?", "HCl is a strong acid, so [H⁺] = 0.001 M", "0.001 = 1 × 10⁻³", "pH = 3"], "Neutralizing: (M × V) of acid = (M × V) of base for one-to-one acids and bases."], "chem10": ["Gas laws connect pressure (P), volume (V), temperature (T) and moles (n). Always use kelvin.", ["K = °C + 273.", "Boyle: P₁V₁ = P₂V₂ (constant T). Charles: V₁/T₁ = V₂/T₂ (constant P). Gay-Lussac: P₁/T₁ = P₂/T₂.", "Combined: P₁V₁/T₁ = P₂V₂/T₂.", "Ideal gas: PV = nRT, R = 0.0821 L·atm/(mol·K). At STP, 1 mol of gas = 22.4 L."], ["6 L at 2 atm is squeezed to 3 atm. New volume?", "Boyle: P₁V₁ = P₂V₂", "2 × 6 = 3 × V₂", "V₂ = 4 L"], "Using °C instead of K in Charles's law is the most common mistake."], "bio1": ["The cell is the basic unit of life. Organelles are its tiny organs, each with a job.", ["Nucleus: holds DNA and controls the cell. Ribosomes: build proteins.", "Mitochondria: release energy (ATP). Chloroplasts: photosynthesis (plants only).", "Cell membrane: controls what enters and leaves. Cell wall: rigid support (plants, fungi, bacteria).", "Prokaryotes (bacteria) have no nucleus. Eukaryotes (plants, animals, fungi) do."], ["Only in plant cells?", "Both: nucleus, mitochondria, ribosomes, membrane", "Plants add: cell wall, chloroplasts, large central vacuole", "Answer: cell wall, chloroplasts or central vacuole"], "Total microscope magnification = eyepiece × objective."], "bio2": ["Cells move materials across their membranes and convert energy to stay alive.", ["Diffusion: high → low concentration, no energy. Osmosis: diffusion of water.", "Active transport: low → high concentration, needs ATP.", "Photosynthesis (chloroplasts): CO₂ + water + light → glucose + O₂.", "Cellular respiration (mitochondria): glucose + O₂ → CO₂ + water + ATP."], ["A red blood cell is put in very salty water", "Salty outside = hypertonic", "Water leaves the cell by osmosis", "The cell shrinks"], "Photosynthesis and respiration are reverses of each other."], "bio3": ["Cells divide to grow, repair and reproduce.", ["Mitosis: 1 cell → 2 identical cells with the full chromosome number (body cells).", "Meiosis: 1 cell → 4 different cells with half the chromosomes (sperm and egg).", "Mitosis phases: Prophase, Metaphase, Anaphase, Telophase (PMAT), then cytokinesis.", "Humans: 46 chromosomes in body cells, 23 in gametes."], ["A cell with 20 chromosomes does meiosis", "Meiosis halves the number", "20 ÷ 2", "Each gamete has 10"], "Metaphase = Middle, Anaphase = Apart."], "bio4": ["Organs work together in systems that keep the body alive.", ["Circulatory: heart and blood vessels. Respiratory: lungs. Digestive: stomach and intestines.", "Nervous: brain, spinal cord, nerves. Endocrine: glands and hormones.", "Arteries carry blood away from the heart, veins carry it back, capillaries exchange materials.", "Red blood cells carry oxygen, white blood cells fight infection, platelets clot."], ["Where are most nutrients absorbed?", "The stomach mostly breaks food down", "The small intestine's villi absorb nutrients", "Answer: small intestine"], "Arteries go Away from the heart."], "bio5": ["Plants make their own food and have special parts for water, food and reproduction.", ["Roots absorb water; stems support and transport; leaves do photosynthesis.", "Xylem carries water up; phloem carries sugar around. Stomata let gases in and out.", "Flowers: stamen (male, makes pollen), pistil (female: stigma, style, ovary).", "Tropisms are growth responses: toward light (photo), gravity (gravi), touch (thigmo)."], ["Which flower part becomes the fruit?", "Pollen fertilizes the ovules inside the ovary", "Ovules become seeds", "The ovary becomes the fruit"], "Phloem carries food (both start with an \"f\" sound); xylem carries water."], "bio6": ["Genes come in versions called alleles. You get one allele from each parent.", ["Dominant (T) shows if present; recessive (t) only shows as tt.", "Homozygous: TT or tt. Heterozygous: Tt. Genotype = letters; phenotype = the trait you see.", "Punnett square: put each parent's alleles on the sides and fill in the 4 boxes. Each box = 25%.", "Tt × Tt → 1 TT : 2 Tt : 1 tt, which gives 3 dominant : 1 recessive."], ["Tt × tt: % short (tt)?", "Boxes: Tt, Tt, tt, tt", "2 of 4 are tt", "50%"], "AaBb × AaBb (two genes) gives the classic 9 : 3 : 3 : 1."], "bio7": ["DNA stores the instructions; RNA carries them; ribosomes build proteins.", ["Base pairs in DNA: A–T and G–C. In RNA, U replaces T (A–U).", "Replication copies DNA. Transcription makes mRNA from DNA. Translation builds a protein.", "mRNA is read in codons (3 bases = 1 amino acid). AUG starts; UAA, UAG, UGA stop.", "Chargaff's rule: %A = %T and %G = %C."], ["DNA template TACGGA → mRNA?", "Pair each base: T→A, A→U, C→G, G→C", "T A C G G A → A U G C C U", "mRNA: AUGCCU"], "Making mRNA? There's no T in RNA, so every A pairs with U."], "bio8": ["Evolution is change in populations over generations, mainly by natural selection.", ["Natural selection: individuals with helpful traits survive and reproduce more.", "Evidence: fossils, homologous structures, DNA similarities, embryos.", "Classification: Domain, Kingdom, Phylum, Class, Order, Family, Genus, Species.", "Scientific names: Genus species, like Homo sapiens (binomial nomenclature)."], ["What comes after Order?", "Domain, Kingdom, Phylum, Class, Order...", "Next is Family", "Answer: Family"], "Memory aid: Dear King Philip Came Over For Good Soup."], "bio9": ["Ecology studies how living things interact with each other and their environment.", ["Producers make food; consumers eat; decomposers recycle dead matter.", "Food chain levels: producer → primary → secondary → tertiary consumer.", "10% rule: only about 10% of energy passes to the next level.", "Symbiosis: mutualism (+/+), commensalism (+/0), parasitism (+/−)."], ["Producers have 10,000 kcal. Energy for secondary consumers?", "Primary consumers get 10%: 1,000 kcal", "Secondary consumers get 10% of that", "= 100 kcal"], "Count the steps from producers: each step divides the energy by 10."], "bio10": ["Microbes include bacteria, viruses, fungi and protists. Your immune system defends against the harmful ones (pathogens).", ["Bacteria are living cells; antibiotics kill them. Viruses need a host cell; antibiotics don't work on them.", "First line of defense: skin and mucus. Then white blood cells such as phagocytes engulf invaders.", "B cells make antibodies that tag antigens; killer T cells destroy infected cells.", "Vaccines safely train the immune system to remember a pathogen (active immunity)."], ["Bacteria double every 20 min. Starting with 100, how many after 1 hour?", "1 hour = 3 doublings", "100 × 2 × 2 × 2", "= 800"], null], "phy1": ["Motion is described by distance, speed, velocity and acceleration.", ["Speed = distance ÷ time. Velocity is speed with a direction.", "Acceleration = change in velocity ÷ time (m/s²).", "Final speed: v = u + at. From rest: distance = ½at².", "Free fall: g = 9.8 m/s² (about 10). km/h ÷ 3.6 = m/s."], ["0 to 20 m/s in 4 s: acceleration?", "Change in velocity = 20 − 0 = 20 m/s", "Divide by time: 20 ÷ 4", "a = 5 m/s²"], "Average speed = total distance ÷ total time, not the average of the speeds."], "phy2": ["Forces push or pull. Newton's three laws describe how forces change motion.", ["1st law (inertia): no net force → no change in motion.", "2nd law: F = ma (newtons = kg × m/s²).", "3rd law: every action has an equal and opposite reaction.", "Weight = mg (g = 9.8 m/s²). Friction = μ × normal force. Net force = add forces in the same direction, subtract opposite ones."], ["30 N push, 10 N friction, 5 kg box. Acceleration?", "Net force = 30 − 10 = 20 N", "a = F ÷ m = 20 ÷ 5", "a = 4 m/s²"], "Mass stays the same everywhere; weight changes with gravity."], "phy3": ["Work moves things, energy is the ability to do work, and power is how fast work is done.", ["Work W = F × d (joules). Power P = W ÷ t (watts).", "Kinetic energy KE = ½mv². Potential energy PE = mgh.", "Energy is conserved: PE at the top becomes KE at the bottom, so v = √(2gh).", "Efficiency = useful output ÷ input × 100%."], ["KE of a 4 kg ball at 3 m/s?", "KE = ½ × m × v²", "= ½ × 4 × 9", "= 18 J"], "Speed is squared in KE: double the speed means 4× the energy."], "phy4": ["Momentum is mass in motion: p = mv. In collisions, total momentum is conserved.", ["p = m × v (kg·m/s).", "Impulse = F × t = change in momentum.", "Total momentum before = total momentum after (when no outside force acts).", "Objects that stick together: (m₁v₁ + m₂v₂) = (m₁ + m₂)v."], ["3 kg cart at 4 m/s hits a 1 kg cart at rest; they stick", "Before: 3 × 4 + 1 × 0 = 12", "After: (3 + 1) × v = 12", "v = 3 m/s"], "Longer stopping time means less force for the same momentum change (airbags, bent knees)."], "phy5": ["Gravity pulls masses together; moving in a circle needs a force toward the center.", ["Gravity ∝ (m₁ × m₂) ÷ distance². Double the distance → ¼ the force.", "Weight on another world = mass × that world's g (Moon 1.6, Mars 3.7 m/s²).", "Centripetal acceleration a = v² ÷ r; centripetal force F = mv² ÷ r.", "Speed around a circle v = 2πr ÷ T (T = time for one lap)."], ["Distance between two planets triples. Gravity?", "Force ∝ 1 ÷ distance²", "3² = 9", "F becomes F/9"], "The centripetal force always points to the center, never outward."], "phy6": ["Fluids (liquids and gases) push on things. Density and pressure explain floating and flow.", ["Density = mass ÷ volume. Less dense than water (1 g/cm³) floats.", "Pressure = force ÷ area (Pa). Water pressure grows with depth: P = ρgh.", "Buoyant force = weight of fluid displaced (Archimedes).", "Hydraulics: F₁/A₁ = F₂/A₂. Pipes: A₁v₁ = A₂v₂. Faster flow means lower pressure (Bernoulli)."], ["50 g object, volume 40 cm³, in water?", "Density = 50 ÷ 40 = 1.25 g/cm³", "1.25 > 1 (water)", "It sinks"], null], "phy7": ["Thermodynamics is about heat, temperature and energy transfer.", ["Q = mcΔT. Water: c = 4.18 J/g·°C.", "K = °C + 273; °F = °C × 9/5 + 32.", "Phase changes use Q = mL (melting ice: 334 J/g; boiling water: 2260 J/g).", "Heat moves by conduction (contact), convection (fluids), radiation (waves). Max engine efficiency = 1 − T_cold ÷ T_hot."], ["Heat to warm 100 g of water by 5 °C?", "Q = m × c × ΔT", "= 100 × 4.18 × 5", "= 2090 J"], "Heat always flows from hot to cold on its own (second law)."], "phy8": ["Waves carry energy. Sound is a longitudinal wave; light is transverse.", ["Wave speed v = f × λ (frequency × wavelength).", "Period T = 1 ÷ f.", "Pitch depends on frequency; loudness on amplitude. +10 dB = 10× intensity.", "Echo: the sound travels there and back, so distance = speed × time ÷ 2."], ["Echo after 2 s, sound at 340 m/s. Distance to wall?", "Total path = 340 × 2 = 680 m", "That's there and back", "Wall = 340 m away"], "Sound needs a medium; it can't cross a vacuum, but light can."], "phy9": ["Electric current is the flow of charge, pushed by voltage and limited by resistance.", ["Ohm's law: V = I × R. Power: P = V × I = I²R.", "Series: R_total = R₁ + R₂ + …, and the current is the same everywhere.", "Parallel (two resistors): R_total = (R₁ × R₂) ÷ (R₁ + R₂), and the voltage is the same on each branch.", "Charge Q = I × t. Energy (kWh) = kW × hours."], ["6 Ω and 3 Ω in parallel?", "Product: 6 × 3 = 18", "Sum: 6 + 3 = 9", "18 ÷ 9 = 2 Ω"], "Parallel total is always smaller than the smallest resistor."], "phy10": ["Magnets and electricity are linked, and light is an electromagnetic wave.", ["Like poles repel, opposite poles attract. Moving a magnet in a coil makes current (induction).", "Transformer: V_out = V_in × (secondary turns ÷ primary turns).", "Reflection: angle in = angle out. Refraction: index n = c ÷ v, and n₁sinθ₁ = n₂sinθ₂.", "Lens: 1/f = 1/d_object + 1/d_image. EM spectrum, longest to shortest wavelength: radio, micro, IR, visible, UV, X-ray, gamma."], ["Lens with f = 10 cm, object at 30 cm. Image?", "1/d_i = 1/10 − 1/30", "= 3/30 − 1/30 = 2/30", "d_i = 15 cm"], "Visible colors from long to short wavelength: ROYGBIV (red to violet)."]});
            Object.assign(HELP, {"calc1": ["A limit is the value f(x) approaches as x gets close to a number, even if f never reaches it there.", ["Try plugging in first. If you get a real number, that's the limit.", "If you get 0/0, factor and cancel, or multiply by the conjugate, then plug in again.", "At infinity: compare the highest powers. Same degree → ratio of leading coefficients; bottom bigger → 0; top bigger → ±∞.", "Special limits: sin x / x → 1 and sin(kx)/x → k as x → 0."], ["lim (x → 3) of (x² − 9)/(x − 3)", "Plugging in gives 0/0", "Factor: (x − 3)(x + 3)/(x − 3) = x + 3", "Plug in 3: limit = 6"], "The limit exists only if the left-side and right-side limits agree."], "calc2": ["The derivative is the slope of the curve, or the instant rate of change.", ["Power rule: d/dx [xⁿ] = n·xⁿ⁻¹. Constants in front stay; constants alone become 0.", "Differentiate a polynomial term by term.", "Works for negative and fraction powers: d/dx [x⁻²] = −2x⁻³, d/dx [√x] = 1/(2√x).", "Tangent line at x = a: slope m = f'(a), passing through (a, f(a))."], ["d/dx [4x³ − 5x + 7]", "4x³ → 12x²", "−5x → −5, and 7 → 0", "= 12x² − 5"], "Bring the power down, then subtract one from the power."], "calc3": ["Products and quotients of functions have their own derivative rules.", ["Product rule: (f·g)' = f'g + fg'.", "Quotient rule: (f/g)' = (f'g − fg')/g².", "Key derivatives: (sin x)' = cos x, (cos x)' = −sin x, (eˣ)' = eˣ, (ln x)' = 1/x.", "Never just multiply the two derivatives together."], ["d/dx [x² sin x]", "f = x², f' = 2x; g = sin x, g' = cos x", "f'g + fg'", "= 2x sin x + x² cos x"], "Quotient rule rhyme: \"low d-high minus high d-low, over low squared\"."], "calc4": ["The chain rule handles a function inside another function.", ["d/dx [f(g(x))] = f'(g(x)) · g'(x): derivative of the outside, times derivative of the inside.", "(ax + b)ⁿ → n·a·(ax + b)ⁿ⁻¹.", "sin(kx) → k cos(kx); e^(kx) → k e^(kx); ln(kx) → 1/x.", "sin(x²) → 2x cos(x²): keep the inside, then multiply by its derivative."], ["d/dx [(3x + 1)⁴]", "Outside: 4(3x + 1)³", "Inside derivative: 3", "= 12(3x + 1)³"], "Forgetting to multiply by the inside's derivative is the #1 chain-rule mistake."], "calc5": ["Derivatives tell you where a function rises, falls, peaks and bends.", ["Critical points: where f'(x) = 0 or is undefined.", "f' > 0 → increasing; f' < 0 → decreasing. f'' > 0 → concave up (local min); f'' < 0 → concave down (local max).", "Optimization: write the quantity as one variable, set its derivative to 0, and solve.", "Motion: velocity = s'(t), acceleration = v'(t). Related rates: differentiate the formula with respect to time."], ["Maximize area with perimeter 40", "Sides x and 20 − x: A = x(20 − x)", "A' = 20 − 2x = 0 → x = 10", "Max area = 10 × 10 = 100"], "For a fixed perimeter, the square always gives the biggest rectangle."], "calc6": ["Integration reverses differentiation: find a function whose derivative is the one you're given.", ["Power rule: ∫ xⁿ dx = xⁿ⁺¹/(n + 1) + C (when n ≠ −1).", "Integrate term by term; constants come along.", "∫ 1/x dx = ln|x| + C; ∫ eˣ dx = eˣ + C.", "∫ cos x dx = sin x + C; ∫ sin x dx = −cos x + C."], ["∫ 6x² dx", "Raise the power: x³", "Divide by the new power: 6x³/3", "= 2x³ + C"], "Check by differentiating your answer: you should get back the original."], "calc7": ["Harder integrals need a technique to turn them into ones you know.", ["u-substitution: let u = the inside function; du replaces its derivative.", "Integration by parts: ∫ u dv = uv − ∫ v du. Pick u by LIATE (Logs, Inverse trig, Algebraic, Trig, Exponential).", "Partial fractions: split 1/((x − a)(x − b)) into A/(x − a) + B/(x − b).", "∫ e^(kx) dx = e^(kx)/k + C; ∫ cos(kx) dx = sin(kx)/k + C."], ["∫ 2x(x² + 1)³ dx", "u = x² + 1, du = 2x dx", "∫ u³ du = u⁴/4", "= (x² + 1)⁴/4 + C"], "If the derivative of the inside is sitting outside, try substitution."], "calc8": ["A definite integral gives the signed area under a curve between two x-values.", ["Fundamental Theorem: ∫ from a to b of f(x) dx = F(b) − F(a), where F' = f.", "Area between curves = ∫ (top − bottom) dx.", "Average value of f on [a, b] = (1/(b − a)) ∫ from a to b of f(x) dx.", "d/dx ∫ from a to x of f(t) dt = f(x)."], ["∫ from 0 to 2 of 3x² dx", "Antiderivative: x³", "F(2) − F(0) = 8 − 0", "= 8"], "Area below the x-axis counts as negative in a definite integral."], "calc9": ["A differential equation relates a function to its derivatives. Separable ones can be split by variable.", ["Separate: put all y's with dy and all x's with dx, then integrate both sides.", "dy/dx = ky gives y = Ce^(kx): exponential growth (k > 0) or decay (k < 0).", "Doubling time d: P = P₀·2^(t/d). Half-life h: A = A₀·(1/2)^(t/h).", "Euler's method: y_new = y_old + h · (slope at the old point)."], ["dy/dx = 2xy", "Separate: dy/y = 2x dx", "Integrate: ln|y| = x² + C", "y = Ce^(x²)"], "Use the starting condition (like y(0) = 3) to find C."], "calc10": ["Sequences are ordered lists; series add them up.", ["Arithmetic: aₙ = a₁ + (n − 1)d, sum Sₙ = n(a₁ + aₙ)/2.", "Geometric: aₙ = a₁·rⁿ⁻¹. Infinite sum = a₁/(1 − r) when |r| < 1.", "Σ 1/n diverges; Σ 1/nᵖ converges if p > 1. If the terms don't go to 0, the series diverges.", "Maclaurin series: eˣ = 1 + x + x²/2! + …, sin x = x − x³/3! + …, 1/(1 − x) = 1 + x + x² + …"], ["4 + 2 + 1 + 1/2 + …", "a₁ = 4, r = 1/2", "Sum = 4 ÷ (1 − 1/2)", "= 8"], "1 + 2 + … + n = n(n + 1)/2 (young Gauss's trick)."], "stat1": ["Mean, median and mode are three ways to describe the center of data.", ["Mean = sum ÷ count.", "Median = the middle value after sorting (average the two middles for an even count).", "Mode = the most common value.", "Outliers pull the mean; the median resists them."], ["Data: 3, 9, 4, 8", "Sum = 24, count = 4 → mean 6", "Sorted: 3, 4, 8, 9 → median (4 + 8)/2 = 6", "No value repeats → no mode"], "Missing value? Total needed = mean × count, minus the known values."], "stat2": ["Range and quartiles describe how spread out data is.", ["Range = max − min.", "Sort the data. Q1 is the median of the lower half and Q3 the median of the upper half (leave the middle value out when the count is odd).", "IQR = Q3 − Q1 (the middle 50%).", "Outliers: below Q1 − 1.5·IQR or above Q3 + 1.5·IQR."], ["Data: 2, 4, 5, 7, 9, 10, 12", "Median = 7; lower half 2, 4, 5 → Q1 = 4", "Upper half 9, 10, 12 → Q3 = 10", "IQR = 10 − 4 = 6"], "A box plot draws exactly these: min, Q1, median, Q3, max."], "stat3": ["Probability = favorable outcomes ÷ total equally likely outcomes.", ["P is between 0 (impossible) and 1 (certain). P(not A) = 1 − P(A).", "Independent events: P(A and B) = P(A) × P(B).", "Mutually exclusive events: P(A or B) = P(A) + P(B).", "Two dice have 36 outcomes; a deck has 52 cards (13 per suit, 4 per rank)."], ["Roll two dice. P(sum = 7)?", "Pairs: (1,6), (2,5), (3,4), (4,3), (5,2), (6,1)", "6 favorable out of 36", "= 1/6"], "Expected value = Σ (value × probability)."], "stat4": ["Counting rules find how many ways things can happen without listing them all.", ["Multiplication principle: a choices then b choices → a × b.", "n! = n × (n − 1) × … × 1, and 0! = 1.", "Permutations (order matters): nPr = n!/(n − r)!.", "Combinations (order doesn't matter): nCr = n!/(r!(n − r)!). Repeated letters: divide by each repeat's factorial."], ["Choose 3 of 7 people for a team", "Order doesn't matter → combination", "7!/(3!·4!) = (7·6·5)/(3·2·1)", "= 35"], "Ask \"does swapping two picks make a new outcome?\" Yes → permutation."], "stat5": ["Conditional probability is the chance of A once you know B happened.", ["P(A | B) = P(A and B) ÷ P(B).", "From a table: count of (A and B) ÷ count of B.", "Without replacement, the second draw's odds change: (r/n) × ((r − 1)/(n − 1)).", "Independent if P(A and B) = P(A) × P(B). Bayes: P(A | B) = P(B | A)·P(A) ÷ P(B)."], ["5 red, 3 blue; draw 2 without replacement. P(both red)?", "First red: 5/8", "Second red: 4/7", "5/8 × 4/7 = 20/56 = 5/14"], "Rare conditions + imperfect tests → most positives can still be false alarms."], "stat6": ["Standard deviation measures how far data typically sits from the mean.", ["Find the mean, then each value's deviation from it.", "Square the deviations and average them: that's the variance (÷ n for a population, ÷ (n − 1) for a sample).", "SD = √variance.", "Adding a constant to every value leaves the SD alone; multiplying every value by k multiplies the SD by k."], ["Data: 2, 4, 4, 6 (population)", "Mean = 4; deviations −2, 0, 0, 2", "Squares: 4, 0, 0, 4 → variance 8/4 = 2", "SD = √2 ≈ 1.41"], null], "stat7": ["A binomial count: n independent trials, each a success with the same probability p.", ["P(X = k) = nCk · pᵏ · (1 − p)ⁿ⁻ᵏ.", "Mean = np; SD = √(np(1 − p)).", "P(at least one) = 1 − P(none) = 1 − (1 − p)ⁿ.", "Conditions (BINS): Binary outcomes, Independent, fixed Number of trials, Same p."], ["4 coin flips, P(exactly 2 heads)?", "4C2 = 6 ways", "Each way: (1/2)⁴ = 1/16", "6/16 = 3/8"], null], "stat8": ["Normal distributions are symmetric bells described by the mean μ and SD σ.", ["z = (x − μ)/σ: how many SDs a value is from the mean.", "x = μ + zσ.", "Empirical rule: 68% within 1σ, 95% within 2σ, 99.7% within 3σ.", "Each tail beyond 1σ holds about 16%; beyond 2σ about 2.5%."], ["Mean 70, SD 5. z-score of 80?", "80 − 70 = 10", "10 ÷ 5", "z = 2"], "Compare scores from different tests with z-scores, not raw points."], "stat9": ["Correlation measures how tightly two variables follow a line; regression finds that line.", ["r is between −1 and 1: sign = direction, size = strength.", "Regression line ŷ = a + bx, with b = r·(s_y/sₓ) and a = ȳ − b·x̄.", "Residual = actual y − predicted ŷ.", "r² = share of the variation in y explained by x. Correlation is not causation!"], ["ŷ = 12 + 1.5x. Predict at x = 10.", "1.5 × 10 = 15", "12 + 15", "ŷ = 27"], "Don't extrapolate far beyond the x-values you have data for."], "stat10": ["Inference uses a sample to draw conclusions about a whole population.", ["Confidence interval: x̄ ± z*·σ/√n. z* = 1.645 (90%), 1.96 (95%), 2.576 (99%).", "Bigger n → narrower interval; higher confidence → wider interval.", "Hypothesis test: z = (x̄ − μ₀)/(σ/√n). If p-value < α, reject H₀.", "Type I error: rejecting a true H₀. Type II: missing a false H₀."], ["σ = 10, n = 25, 95% confidence", "σ/√n = 10/5 = 2", "Margin of error = 1.96 × 2", "= 3.92"], "\"Fail to reject H₀\" is not the same as proving H₀ true."]});
            Object.assign(HELP, {"anc1": ["Mesopotamia, the \"land between the rivers\" (Tigris and Euphrates, in modern Iraq), was home to some of the world's first cities.", ["Sumer (c. 3500 BCE) built city-states like Ur and Uruk, each with a ziggurat temple.", "Sumerians invented cuneiform writing on clay tablets and counted in base 60.", "Sargon of Akkad built the first empire; later Hammurabi of Babylon wrote a famous law code.", "Assyria (capital Nineveh) and the Neo-Babylonians (Nebuchadnezzar II) followed, until Persia took Babylon in 539 BCE."], ["Who wrote an early law code known for \"an eye for an eye\"?", "Law codes were written by kings to unite their empires", "The famous Babylonian one dates to about 1750 BCE", "Answer: Hammurabi"], "Order of the big four: Sumer → Akkad → Babylon → Assyria."], "anc2": ["Ancient Egypt grew along the Nile, whose yearly flood left rich soil. It lasted about 3,000 years under pharaohs.", ["Eras: Old Kingdom (pyramids), Middle Kingdom, New Kingdom (empire, Valley of the Kings).", "Pharaohs were seen as god-kings; mummification prepared them for the afterlife.", "Writing: hieroglyphics (formal) and hieratic (quick script), decoded with the Rosetta Stone.", "Famous rulers: Khufu, Hatshepsut, Akhenaten, Tutankhamun, Ramesses II and Cleopatra VII."], ["Which pharaoh was the Great Pyramid built for?", "The Giza pyramids are Old Kingdom tombs", "The largest belongs to the 4th-dynasty king", "Answer: Khufu"], "Old Kingdom = pyramids; New Kingdom = Valley of the Kings and big empire."], "anc3": ["Ancient Greece was a land of independent city-states (poleis) that shared a language, gods and the Olympic Games.", ["Athens developed democracy (Cleisthenes, Pericles); Sparta was a military state.", "The Greeks beat Persia (Marathon 490, Salamis 480 BCE), then Athens and Sparta fought the Peloponnesian War.", "Philosophers: Socrates → Plato → Aristotle (who tutored Alexander the Great).", "Alexander's conquests spread Greek culture, starting the Hellenistic period."], ["Which battle gave its name to a 26-mile race?", "The Greeks beat a Persian army in 490 BCE", "A runner supposedly carried the news to Athens", "Answer: Marathon"], "Remember the teacher chain: Socrates taught Plato, Plato taught Aristotle, Aristotle taught Alexander."], "anc4": ["Rome grew from a small city (legend: Romulus, 753 BCE) into a republic and then an empire that ruled the Mediterranean.", ["Republic: Senate plus two consuls each year; patricians (nobles) and plebeians (commoners).", "Rome beat Carthage in the Punic Wars (Hannibal crossed the Alps).", "Julius Caesar was killed in 44 BCE; Augustus became the first emperor.", "Constantine legalized Christianity and founded Constantinople; the West fell in 476 CE."], ["Who was the first Roman emperor?", "Julius Caesar was a dictator, not an emperor", "His adopted heir Octavian won the civil war (Actium, 31 BCE)", "Answer: Augustus"], "Republic first (elected consuls), empire second (Augustus onward)."], "anc5": ["Chinese civilization began along the Yellow River and was ruled by a series of dynasties.", ["Shang (oracle bones) → Zhou (Mandate of Heaven, longest) → Qin (first emperor) → Han (Silk Road).", "Qin Shi Huang unified China in 221 BCE, standardized writing and built early Great Wall sections.", "Big ideas: Confucianism (family, respect), Daoism (the Way) and Legalism (strict laws).", "Han inventions include paper; the Silk Road linked China to Rome."], ["Which dynasty first unified China?", "Earlier dynasties ruled only part of China", "In 221 BCE one state conquered its rivals", "Answer: Qin (the name \"China\" may come from it)"], "Dynasty order: \"Shang, Zhou, Qin, Han\" — say it like a chant."], "anc6": ["India's first civilization grew along the Indus River; later empires united much of the subcontinent.", ["Indus Valley cities like Harappa and Mohenjo-daro were carefully planned; their script is undeciphered.", "Hinduism (Vedas, karma, reincarnation) and Buddhism (Siddhartha Gautama, nirvana) began here.", "Maurya Empire: Chandragupta founded it; Ashoka turned to Buddhism after Kalinga.", "Gupta Empire was a Golden Age: zero, decimals, Aryabhata, great literature."], ["Which emperor turned to Buddhism after a bloody war?", "The Mauryan Empire conquered Kalinga", "The emperor regretted the slaughter and spread Buddhist ideas", "Answer: Ashoka"], "Maurya = big empire (Ashoka); Gupta = Golden Age (zero)."], "anc7": ["The Persian (Achaemenid) Empire, founded by Cyrus the Great around 550 BCE, was the largest empire of its time.", ["Cyrus was known for tolerance, letting conquered peoples keep their customs.", "Darius I organized satrapies (provinces), coins and the Royal Road; he began Persepolis.", "Persia invaded Greece twice (Darius, then Xerxes) and lost.", "Alexander the Great conquered Persia around 330 BCE; later the Sasanians ruled until the Arab conquests."], ["Who invaded Greece in 480 BCE?", "Darius I's attack failed at Marathon in 490 BCE", "His son led a huge second invasion", "Answer: Xerxes I"], "Cyrus founded, Darius organized, Xerxes invaded."], "anc8": ["Long before Europeans arrived, complex civilizations grew across the Americas.", ["The Olmec (from c. 1200 BCE) carved giant stone heads; they're called Mesoamerica's \"mother culture.\"", "The Maya built cities like Tikal and Chichén Itzá, used glyphs, a base-20 system with zero, and the Long Count calendar.", "Teotihuacan near Mexico City had the Pyramid of the Sun.", "North America: Mississippian mound builders (Cahokia) and Ancestral Puebloans (Mesa Verde)."], ["Which civilization carved colossal stone heads?", "They were the earliest major Mesoamerican culture", "Their heads stand up to 3 m tall", "Answer: Olmec"], "Olmec came first; Maya peaked 250–900 CE; Aztec and Inca came much later."], "anc9": ["Several of the world's major religions began in the ancient world.", ["Abrahamic faiths (one god): Judaism (Torah, Moses), Christianity (Jesus, Paul), Islam (Muhammad, Quran).", "From India: Hinduism (Vedas, karma, many gods) and Buddhism (Four Noble Truths, Eightfold Path).", "From China and Japan: Confucianism (Analects), Daoism (Tao Te Ching), Shinto (kami).", "Key splits: Sunni/Shia in Islam; Theravada/Mahayana in Buddhism."], ["What are the Five Pillars?", "Each religion has core practices", "Faith, prayer, charity, fasting and pilgrimage (Hajj)", "Answer: the basic duties of Islam"], "Match each faith with its book: Torah, Bible, Quran, Vedas, Analects, Tao Te Ching."], "anc10": ["The Seven Wonders of the Ancient World were famous monuments listed by Greek writers.", ["The Great Pyramid of Giza is the only wonder still standing.", "Others: Hanging Gardens of Babylon, Statue of Zeus (Olympia), Temple of Artemis (Ephesus), Mausoleum at Halicarnassus.", "Colossus of Rhodes (Helios) and Lighthouse of Alexandria (Pharos) complete the list.", "Ancient genius: Archimedes, Euclid, Eratosthenes, Hero's steam device, Roman concrete."], ["Which wonder gave us the word \"mausoleum\"?", "It was the tomb of a ruler named Mausolus", "It stood at Halicarnassus", "Answer: the Mausoleum at Halicarnassus"], "Only the oldest one, the Great Pyramid, survives."], "med1": ["The Byzantine Empire was the eastern Roman Empire, which lasted about 1,000 years after the West fell.", ["Capital: Constantinople (now Istanbul); language: mostly Greek; faith: Eastern Orthodox.", "Justinian I built Hagia Sophia and issued a famous law code, with Empress Theodora.", "The Great Schism (1054) split the Orthodox and Roman Catholic churches.", "The Fourth Crusade sacked the city in 1204; the Ottomans conquered it in 1453."], ["When did Constantinople fall to the Ottomans?", "Sultan Mehmed II besieged it with huge cannons", "Emperor Constantine XI died defending it", "Answer: 1453"], "476 = West falls; 1453 = East falls."], "med2": ["Islam began in Arabia with the prophet Muhammad and spread quickly across three continents.", ["Muhammad was born in Mecca; the Hijra to Medina in 622 starts the Islamic calendar.", "Caliphs led after him: the Rightly Guided Caliphs, then the Umayyads (Damascus) and Abbasids (Baghdad).", "The Abbasid Golden Age: the House of Wisdom, algebra (al-Khwarizmi), medicine (Ibn Sina).", "Muslim Spain (al-Andalus) flourished; the Mongols sacked Baghdad in 1258."], ["Which dynasty built Baghdad?", "The Umayyads ruled from Damascus", "Their successors moved the capital east in 762", "Answer: the Abbasids"], "Umayyad = Damascus; Abbasid = Baghdad and the Golden Age."], "med3": ["Medieval Europe was organized by feudalism: land in exchange for loyalty and service.", ["Kings → lords → vassals (knights) → serfs who worked the manor.", "The Catholic Church was the most powerful institution; people paid it a tithe.", "Key moments: Charlemagne crowned (800), Norman conquest (1066), Magna Carta (1215).", "The Black Death (1347–51) and the Hundred Years' War helped end the feudal order."], ["What did Magna Carta do?", "English barons rebelled against King John", "In 1215 he agreed the king must also follow the law", "Answer: it limited the king's power"], "Feudalism is a pyramid: few at the top, many serfs at the bottom."], "med4": ["The Vikings were Scandinavian seafarers who raided, traded and settled from about 793 to 1066.", ["Longships let them raid coasts and sail up rivers; the Lindisfarne raid (793) began the Viking Age.", "They settled England's Danelaw, Normandy (Rollo), Iceland and Greenland (Erik the Red).", "Leif Erikson reached North America around 1000 (L'Anse aux Meadows).", "Norse gods: Odin, Thor, Loki; heroes went to Valhalla. Laws were made at a \"thing.\""], ["Who reached North America first, about 1000 CE?", "Erik the Red settled Greenland", "His son sailed farther west to Vinland", "Answer: Leif Erikson"], "1066 ends the Viking Age (Stamford Bridge) and begins Norman England (Hastings)."], "med5": ["The Crusades (1095–1291) were wars by European Christians to win the Holy Land.", ["Pope Urban II called the First Crusade (1095); it took Jerusalem in 1099.", "Saladin retook Jerusalem in 1187 after the Battle of Hattin.", "Richard the Lionheart led the Third Crusade; the Fourth sacked Constantinople (1204).", "The Mamluks took Acre, the last crusader stronghold, in 1291."], ["Which crusade attacked a Christian city?", "Crusaders ran short of money for ships from Venice", "They were diverted and sacked Constantinople in 1204", "Answer: the Fourth Crusade"], "Only the First Crusade captured Jerusalem by force."], "med6": ["The Mongols, nomadic horse archers from the steppe, built the largest land empire in history.", ["Temüjin became Genghis Khan in 1206 and united the Mongol tribes.", "His heirs split the empire into khanates: Yuan (China), Golden Horde (Russia), Ilkhanate (Persia), Chagatai.", "Kublai Khan founded the Yuan dynasty and hosted Marco Polo.", "The Pax Mongolica made Silk Road travel safer; the Mamluks stopped them at Ain Jalut (1260)."], ["Who ruled China as a Mongol emperor?", "Genghis Khan never ruled all of China", "His grandson completed the conquest and founded the Yuan", "Answer: Kublai Khan"], "Genghis = founder; Kublai = grandson in China."], "med7": ["The Aztec and Inca were the great American empires when the Spanish arrived in the 1500s.", ["Aztecs: capital Tenochtitlan on Lake Texcoco, chinampa farms, language Nahuatl.", "Inca: capital Cusco in the Andes, 40,000 km of roads, quipu records, language Quechua.", "Cortés defeated the Aztecs (1521) with Tlaxcalan allies; Pizarro captured Atahualpa (1532–33).", "Smallpox and other diseases killed far more people than battles."], ["Who conquered the Inca?", "The Aztecs fell to Hernán Cortés", "The Inca fell to a different conquistador", "Answer: Francisco Pizarro"], "Aztec = Mexico + Cortés; Inca = Peru + Pizarro."], "med8": ["The Renaissance (\"rebirth\") was a revival of classical learning and art, starting in Italy around 1400.", ["It began in Florence, backed by patrons like the Medici family.", "Humanism focused on human potential and Greek and Roman texts (Petrarch, Erasmus).", "Artists: Leonardo (Mona Lisa), Michelangelo (Sistine Chapel, David), Raphael (School of Athens).", "Gutenberg's printing press (c. 1440) spread ideas fast; the Renaissance moved north to Dürer and Shakespeare."], ["Who painted the Sistine Chapel ceiling?", "Leonardo painted the Mona Lisa and The Last Supper", "The ceiling (1508–12) was by the sculptor of David", "Answer: Michelangelo"], "Linear perspective is the key Renaissance painting trick for showing depth."], "med9": ["The Reformation split Western Christianity into Catholic and Protestant churches in the 1500s.", ["Martin Luther posted his Ninety-five Theses in 1517, attacking the sale of indulgences.", "John Calvin (Geneva), Zwingli (Zürich) and Knox (Scotland) led other reforms; Henry VIII founded the Church of England.", "Catholics answered with the Counter-Reformation: the Council of Trent and the Jesuits.", "Religious wars followed, ending with the Peace of Augsburg (1555) and Peace of Westphalia (1648)."], ["What did Luther protest in 1517?", "The Church raised money by selling forgiveness of sins", "These payments were called indulgences", "Answer: the sale of indulgences"], "The printing press is why the Reformation spread so fast."], "med10": ["In the Age of Exploration (c. 1400–1600), European sailors found new sea routes and lands.", ["Portugal led along Africa: Henry the Navigator, Dias (Cape of Good Hope 1488), da Gama (India 1498).", "Spain sent Columbus (1492); Magellan's expedition sailed around the world (1519–22).", "The Treaty of Tordesillas (1494) split new lands between Spain and Portugal.", "Results: the Columbian Exchange, colonies, mercantilism and the Atlantic slave trade."], ["Who first sailed from Europe around Africa to India?", "Dias reached Africa's southern tip in 1488", "Ten years later another Portuguese captain reached India", "Answer: Vasco da Gama"], "Portugal went east around Africa; Spain went west across the Atlantic."], "mod1": ["The Enlightenment (1700s) applied reason to government and society; it grew out of the Scientific Revolution.", ["Scientific Revolution: Copernicus, Galileo, Kepler and Newton explained the heavens with math and experiment.", "Locke: natural rights to life, liberty and property; Hobbes argued for a strong ruler.", "Montesquieu: separation of powers; Voltaire: free speech; Rousseau: the social contract.", "These ideas inspired the American and French Revolutions."], ["Whose idea is the separation of powers?", "Locke wrote about natural rights", "A French thinker proposed three branches in The Spirit of the Laws", "Answer: Montesquieu"], "Match the thinker to the idea: Locke-rights, Montesquieu-branches, Voltaire-speech, Rousseau-social contract."], "mod2": ["The American Revolution (1775–1783) won independence for 13 British colonies.", ["British taxes (Stamp Act 1765, Tea Act) led to protests like the Boston Tea Party (1773).", "War began at Lexington and Concord (1775); the Declaration of Independence came on July 4, 1776.", "Saratoga (1777) brought France in as an ally; the British surrendered at Yorktown (1781).", "The Treaty of Paris (1783) ended the war; the Articles of Confederation were replaced by the Constitution."], ["Which battle was the turning point?", "Early on the Americans needed foreign help", "A big win in 1777 convinced France to join", "Answer: Saratoga"], "Saratoga = turning point; Yorktown = the end."], "mod3": ["The French Revolution (1789–1799) overthrew the monarchy and spread ideas of liberty and equality.", ["The Third Estate (commoners) formed the National Assembly and took the Tennis Court Oath.", "The Bastille fell on July 14, 1789; the Declaration of the Rights of Man followed.", "Louis XVI and Marie Antoinette were executed (1793) during the Reign of Terror (Robespierre).", "Napoleon took power in 1799, made the Napoleonic Code, and fell at Waterloo (1815)."], ["What happened on July 14, 1789?", "Crowds feared the king would crush the new Assembly", "They stormed a royal fortress-prison in Paris", "Answer: the storming of the Bastille"], "Order: Estates-General → Bastille → Terror → Napoleon."], "mod4": ["The Industrial Revolution moved work from homes and farms into factories, starting in Britain around 1760.", ["Textiles came first: spinning jenny, water frame, and Whitney's cotton gin.", "Watt's improved steam engine, coal and iron powered factories, railways and steamships.", "Cities grew fast (urbanization) with harsh conditions, child labor and new labor unions.", "A second wave brought steel (Bessemer), electricity, telephones and Ford's assembly line."], ["Why did industry start in Britain?", "It had plenty of coal and iron", "It also had capital, colonies, workers and rivers for transport", "Answer: resources plus money, markets and labor"], "Steam + coal = the first Industrial Revolution; steel + electricity = the second."], "mod5": ["The U.S. Civil War (1861–1865) was fought between the Union (North) and the Confederacy (South), mainly over slavery.", ["Eleven Southern states seceded after Lincoln's election; the war began at Fort Sumter.", "The Emancipation Proclamation (1863) freed enslaved people in rebel states.", "Gettysburg and Vicksburg (1863) turned the war; Lee surrendered at Appomattox (1865).", "The 13th Amendment ended slavery; Reconstruction tried to rebuild the South."], ["Which amendment abolished slavery?", "The Emancipation Proclamation covered only rebel states", "A constitutional amendment in 1865 ended slavery everywhere", "Answer: the 13th"], "13th = freedom, 14th = citizenship, 15th = voting (for men regardless of race)."], "mod6": ["In the Age of Imperialism (about 1870–1914), industrial powers took control of much of Africa and Asia.", ["Motives: raw materials, markets, national pride and racist ideas of superiority.", "The Berlin Conference (1884–85) split Africa among Europeans; only Ethiopia and Liberia stayed independent.", "Britain ruled India after the 1857 rebellion; China lost wars (Opium Wars) and faced the Boxer Rebellion.", "Japan modernized (Meiji Restoration); the U.S. gained colonies after the Spanish-American War."], ["Which African nation defeated a European invader in 1896?", "Italy invaded from its Red Sea colony", "Emperor Menelik II's army won decisively", "Answer: Ethiopia, at the Battle of Adwa"], "Ethiopia and Liberia were the only African nations never colonized in this era."], "mod7": ["World War I (1914–1918) pitted the Allies against the Central Powers and killed about 20 million people.", ["Causes: militarism, alliances, imperialism and nationalism (\"MAIN\").", "The spark: Archduke Franz Ferdinand was shot in Sarajevo in 1914.", "Trench warfare stalled the Western Front (Verdun, the Somme); the U.S. joined in 1917.", "The Treaty of Versailles (1919) blamed Germany; Wilson's League of Nations was created."], ["What were the four main causes of WWI?", "Think of the acronym MAIN", "Militarism, Alliances, Imperialism, Nationalism", "Answer: MAIN"], "Allies: Britain, France, Russia (later U.S.). Central Powers: Germany, Austria-Hungary, Ottomans."], "mod8": ["World War II (1939–1945) was the deadliest war in history, fought between the Allies and the Axis.", ["Germany invaded Poland in 1939; Japan attacked Pearl Harbor in 1941, bringing in the U.S.", "Turning points: Midway (1942), Stalingrad (1942–43), D-Day (June 6, 1944).", "The Holocaust murdered about six million Jews and millions of others.", "Germany surrendered in May 1945; Japan surrendered after the atomic bombings of Hiroshima and Nagasaki."], ["Which battle turned the tide in the Pacific?", "Pearl Harbor was the start, not a turning point", "In June 1942 the U.S. sank four Japanese carriers", "Answer: Midway"], "Axis: Germany, Italy, Japan. Big Three Allies: U.S., Britain, USSR."], "mod9": ["The Cold War (1947–1991) was a rivalry between the U.S. and the Soviet Union without direct war between them.", ["Europe was split by the Iron Curtain; NATO faced the Warsaw Pact.", "The U.S. tried containment: the Marshall Plan, the Berlin Airlift, the Korean and Vietnam wars.", "Crises: the Cuban Missile Crisis (1962) nearly led to nuclear war; the Space Race followed Sputnik (1957).", "Gorbachev's reforms, the fall of the Berlin Wall (1989) and the USSR's collapse (1991) ended it."], ["What was containment?", "After WWII the U.S. feared communism would spread", "The policy aimed to stop it from expanding to new countries", "Answer: the U.S. strategy of stopping communism's spread"], "\"Cold\" because the superpowers never fought each other directly."], "mod10": ["Civil rights movements fought for equal rights regardless of race or sex, in the U.S. and around the world.", ["Plessy v. Ferguson (1896) allowed segregation; Brown v. Board (1954) ended it in schools.", "Rosa Parks and the Montgomery bus boycott (1955) helped make Martin Luther King Jr. a leader.", "The Civil Rights Act (1964) and Voting Rights Act (1965) became law after protests like Selma.", "Worldwide: Gandhi's nonviolence freed India (1947); Mandela helped end apartheid (1994)."], ["Which case overturned \"separate but equal\" in schools?", "Plessy v. Ferguson allowed separate facilities in 1896", "In 1954 the Supreme Court ruled unanimously against school segregation", "Answer: Brown v. Board of Education"], "Plessy (1896) allowed segregation; Brown (1954) began ending it."]});
            Object.assign(HELP, {"gram1": ["Every word in a sentence has a job. Those jobs are the parts of speech.", ["Nouns name things (dog, city, joy); pronouns replace them (she, it, they).", "Verbs show action or being (run, is); adjectives describe nouns (red, tall).", "Adverbs describe verbs, adjectives or other adverbs (quickly, very); prepositions show relationships (in, under).", "Conjunctions join (and, because); interjections show feeling (Wow!)."], ["What part of speech is \"softly\" in \"He spoke softly\"?", "It describes how he spoke, the verb", "Words that describe verbs are adverbs", "Answer: adverb"], "Ask what the word is DOING in this sentence. \"Fast\" can be an adjective or an adverb."], "gram2": ["Nouns name people, places, things and ideas. Pronouns stand in for nouns. Pronoun case depends on the pronoun's job: subject (I, he, who), object (me, him, whom) or possessive (my, mine, whose).", ["Proper nouns are specific and capitalized (Chicago); common nouns are general (city).", "Plurals: add -s or -es; y → ies (city → cities); f → ves (knife → knives); some are irregular (child → children, mouse → mice).", "Possessives: one owner → dog's; plural ending in s → girls'; irregular plural → children's.", "Pronoun types: personal (I, she), reflexive (myself), demonstrative (this), relative (who, which), indefinite (everyone).", "Subject: \"Sara and I went.\" Object: \"He helped Sara and me.\"", "Who = subject (he); whom = object (him).", "After \"than\" or \"is\" in formal writing: \"taller than I (am),\" \"It was she.\"", "Whose is possessive; who's means who is. Reflexive pronouns (myself) need an earlier subject."], ["Possessive of \"the girls\"?", "\"Girls\" is plural and already ends in s", "Just add an apostrophe after the s", "Answer: the girls'"], "Make it plural first, then make it possessive."], "gram3": ["Verb tenses show when something happens: past, present or future, each with simple, progressive and perfect forms. Voice shows who does the action; mood shows the speaker's attitude.", ["Simple: walk / walked / will walk. Progressive: is walking. Perfect: has walked, had walked, will have walked.", "Irregular verbs change form: go/went/gone, see/saw/seen, bring/brought.", "Past perfect (had + participle) shows the earlier of two past events.", "Lie (recline): lie/lay/lain. Lay (put down): lay/laid/laid.", "Active: the subject acts (\"Sam ate the cake\"). Passive: the subject receives the action (\"The cake was eaten\").", "Passive is useful when the doer is unknown or unimportant, but active is usually clearer.", "Indicative mood states facts; imperative gives commands (\"Close the door\").", "Subjunctive shows wishes or demands: \"If I were you,\" \"I insist that he be on time.\""], ["Past tense of \"lie\" (to recline)?", "Lie is irregular: lie, lay, lain", "Don't confuse it with lay (to put), whose past tense is laid", "Answer: lay"], "Test with \"have ___\" to find the past participle: have gone, have written, have swum."], "gram4": ["Adjectives describe nouns; adverbs describe verbs, adjectives and other adverbs.", ["Many adverbs end in -ly (quickly), but not all (fast, very, often).", "Comparatives compare two (taller, more careful); superlatives compare three or more (tallest, most careful).", "Irregular forms: good/better/best, bad/worse/worst, far/farther/farthest.", "Good is an adjective, well is usually the adverb: \"She sings well.\" After linking verbs, use adjectives: \"I feel bad.\""], ["\"He did ___ on the test.\"", "The word describes how he did, the action", "Actions take adverbs", "Answer: well"], "Two things → -er / more. Three or more → -est / most."], "gram5": ["A verb must agree with its subject in number: singular subjects take singular verbs.", ["\"The dog barks\" but \"The dogs bark.\"", "Each, everyone, every one and one of… are singular: \"One of the boxes is broken.\"", "With or/nor, the verb agrees with the nearer subject.", "\"The number of\" is singular; \"a number of\" is plural. Plural-looking words like news and mathematics are singular."], ["\"One of the boxes ___ broken.\"", "The subject is \"One,\" not \"boxes\"", "\"Of the boxes\" is just a prepositional phrase", "Answer: is"], "Cross out prepositional phrases to find the real subject."], "gram6": ["Punctuation marks guide the reader: where to stop, pause, list, quote or show ownership.", ["End marks: . ? !  Commas separate list items, introductory words and clauses joined by a conjunction.", "Semicolons join two complete, related sentences; colons introduce lists or explanations.", "Apostrophes show possession (the dog's bone) or contractions (it's = it is). The possessive \"its\" has no apostrophe.", "Dashes and paired commas set off extra information; a comma alone can't join two sentences (comma splice)."], ["\"The cat licked ___ paw.\" its or it's?", "Try \"it is\": \"The cat licked it is paw\" doesn't work", "So use the possessive, which has no apostrophe", "Answer: its"], "It's = it is. If \"it is\" doesn't fit, write its."], "gram7": ["Conjunctions join words and clauses; prepositions link nouns to the rest of the sentence.", ["Coordinating conjunctions (FANBOYS): for, and, nor, but, or, yet, so.", "Subordinating conjunctions start dependent clauses: because, although, when, if, since.", "Correlative pairs: both/and, either/or, neither/nor, not only/but also.", "Prepositions (in, on, of, between, despite) start phrases. Some verbs need a specific one: insist on, afraid of, interested in."], ["\"___ the rain, we went hiking.\"", "\"The rain\" is a noun, not a clause with a verb", "Use a preposition, not a conjunction like \"although\"", "Answer: Despite"], "Conjunctions join clauses (with verbs); prepositions take nouns."], "gram8": ["Sentences are built from clauses (subject + verb) and phrases (groups without both).", ["An independent clause can stand alone; a dependent clause can't (\"because it was late\").", "Clauses can act as adjectives (the book that I read), adverbs (when I arrive) or nouns (what she said).", "Objects: direct (kicked the ball) and indirect (gave her friend a gift).", "Modifiers must sit next to what they describe, or they dangle or are misplaced."], ["Is \"because it was late\" a sentence?", "It has a subject (it) and a verb (was)", "But \"because\" makes it depend on another clause", "Answer: no, it's a dependent clause"], "If you can't say it alone as a complete thought, it's dependent."], "voc1": ["Synonyms are words with the same or nearly the same meaning. Antonyms are words with opposite meanings.", ["Synonyms let you avoid repetition: big, large, huge, enormous.", "They differ in strength and tone: angry < furious; thin vs. skinny vs. slender.", "Harder words often have simple synonyms: laconic = terse, sanguine = optimistic.", "A thesaurus lists synonyms, but check that the meaning fits your sentence.", "Simple pairs: hot/cold, win/lose, early/late.", "Prefixes can form antonyms: happy/unhappy, agree/disagree.", "Some words have opposites of different strength: generous ↔ stingy, verbose ↔ concise.", "Watch out for synonyms hiding among the choices; they're the trap answers."], ["Synonym of \"diligent\"?", "Diligent describes someone who works steadily", "Its closest match is hardworking, not lazy or careless", "Answer: hardworking"], "Swap the word into a sentence. A true synonym keeps the meaning."], "voc3": ["A prefix goes at the start of a word and changes its meaning. A suffix goes at the end of a word. It changes meaning or part of speech. Many English words are built from Greek and Latin roots. Knowing the root unlocks the meaning.", ["un-, dis-, in- = not; re- = again; pre- = before; mis- = wrongly.", "sub- = under; trans- = across; inter- = between; anti- / contra- = against.", "bi- = two; semi- = half; omni- = all; circum- = around.", "Advanced: ante- = before, retro- = backward, hyper- = over, hypo- = under, pseudo- = false.", "-ful = full of; -less = without; -er / -ist = one who.", "-ness and -tion make nouns; -ize makes verbs; -ly usually makes adverbs.", "-ology = study of; -phobia = fear of; -cide = killing.", "-cracy / -archy = rule; -itis = inflammation; -ectomy = surgical removal.", "bio = life, geo = earth, graph = write, phon = sound, tele = far.", "port = carry, dict = say, spect / vis = see, aud = hear, rupt = break.", "chron = time, scrib / script = write, manu = hand, ped = foot (Latin).", "Advanced: ambul = walk, loqu = speak, anthrop = human, phil = love, morph = form."], ["What does \"transatlantic\" mean?", "trans- means across", "Atlantic is the ocean", "Answer: across the Atlantic"], "hyPER = suPER-high; hyPO = below (like hypothermia)."], "voc6": ["Homophones sound the same but differ in spelling and meaning.", ["there (place) / their (belongs to them) / they're (they are).", "to (direction) / too (also, excessively) / two (2).", "Others: hear/here, write/right, flour/flower, reign/rein, peak/peek/pique.", "principal (head of school, main) vs. principle (a rule or belief)."], ["\"___ going to the park.\"", "The sentence needs \"they are\"", "The contraction of \"they are\" is they're", "Answer: They're"], "The principal is your pal; a principle is a rule."], "voc7": ["Some word pairs get mixed up because they look or sound alike.", ["affect (verb, to influence) vs. effect (noun, a result).", "accept (receive) vs. except (leave out); than (compare) vs. then (time).", "imply (the speaker hints) vs. infer (the listener concludes).", "Advanced: elicit/illicit, discreet/discrete, averse/adverse, disinterested (impartial)/uninterested (bored)."], ["\"The rain ___ my mood.\" affected or effected?", "You need a verb meaning \"influenced\"", "Affect is the usual verb; effect is usually the noun", "Answer: affected"], "RAVEN: Remember, Affect is a Verb, Effect is a Noun."], "voc8": ["Good spelling comes from patterns plus a few memorized trouble words.", ["\"i before e except after c\": receive, ceiling (with exceptions like weird).", "Double letters trip people up: accommodate (cc, mm), embarrass (rr, ss), occurrence (cc, rr).", "American vs. British: color/colour, center/centre, analyze/analyse, traveled/travelled, defense/defence.", "Watch for \"a rat\" in separate, \"finite\" in definitely, and \"ss\" plus \"ss\" in possess."], ["Correct American spelling: color or colour?", "British spelling keeps the u (colour)", "American spelling drops it", "Answer: color"], "Questions say which version they want, so check whether it asks for American or British."], "voc9": ["Context clues are hints in the surrounding words that help you work out an unfamiliar word.", ["Definition or restatement: \"arid, or very dry, land.\"", "Contrast: \"Unlike his chatty sister, Tom is quiet.\" (chatty is the opposite of quiet)", "Example: \"vital organs such as the heart and lungs.\"", "Cause and effect: \"We were famished, so we ate everything.\""], ["\"The arid desert gets almost no rain.\" What is arid?", "The clue is \"almost no rain\"", "Little rain means dry", "Answer: very dry"], "Cover the word and guess what would fit, then pick the closest choice."], "voc10": ["Advanced vocabulary includes precise words common on the SAT, ACT and GRE.", ["Many have Latin roots: benevolent (bene = good), loquacious (loqu = speak).", "Learn words in families: verbose, laconic, taciturn, loquacious (all about talking).", "Some sound alike but differ: capricious (unpredictable) vs. capacious (roomy).", "Use new words in your own sentences to make them stick."], ["What does \"pusillanimous\" mean?", "pusill(us) = very small, anim(us) = spirit", "A small spirit means lacking courage", "Answer: cowardly"], "Roots and prefixes crack many \"impossible\" words."], "wri1": ["Sentences have four purposes, and each has its own end mark. Sentence structure depends on how many independent and dependent clauses a sentence has.", ["Declarative: makes a statement and ends with a period.", "Interrogative: asks a question and ends with a question mark.", "Imperative: gives a command or request; the subject \"you\" is understood.", "Exclamatory: shows strong feeling and ends with an exclamation point.", "Simple: one independent clause (it can still have compound subjects or verbs).", "Compound: two or more independent clauses joined by a comma + FANBOYS or a semicolon.", "Complex: one independent clause + at least one dependent clause.", "Compound-complex: two or more independent clauses + at least one dependent clause."], ["What type is \"Turn off the lights.\"?", "It tells someone to do something", "Commands are imperative, with an understood \"you\"", "Answer: imperative"], "Commands often start with a verb: Sit, Go, Please pass…"], "wri3": ["Every sentence needs a subject, a verb and a complete thought.", ["Fragment: a piece of a sentence (\"Because I was late.\").", "Run-on (fused): two sentences with no punctuation between them.", "Comma splice: two sentences joined by only a comma.", "Fixes: a period, a semicolon, a comma + FANBOYS, or making one clause dependent."], ["Fix \"It rained we stayed in.\"", "There are two complete thoughts with nothing between them", "Join them with a comma and \"so\"", "Answer: It rained, so we stayed in."], "A comma alone is never enough to join two complete sentences."], "wri4": ["Transitions are words that show how ideas connect. A paragraph develops one main idea with a clear structure.", ["Addition: also, furthermore, in addition. Contrast: however, in contrast, nevertheless.", "Cause/effect: therefore, as a result, consequently, hence.", "Example: for example, for instance. Sequence: first, next, finally.", "Conclusion: in conclusion, overall. Concession: admittedly, granted.", "The topic sentence states the main idea; supporting details prove it; the concluding sentence wraps up.", "Unity: every sentence relates to the main idea. Coherence: ideas flow logically.", "Organization patterns: chronological, spatial, order of importance, compare/contrast, cause/effect.", "Claim → evidence → reasoning explains WHY the evidence supports the point."], ["\"It rained. ___, we played outside.\"", "Playing outside happens despite the rain", "That calls for a contrast or concession transition", "Answer: Nevertheless"], "Name the relationship first (contrast? result?), then choose the word."], "wri6": ["An essay argues or explains one central idea, the thesis, across several paragraphs. Writing modes and purposes shape how you write.", ["Introduction: hook, background, thesis (usually the last sentence).", "Body paragraphs: each supports the thesis with evidence.", "Conclusion: restates the thesis and explains why it matters.", "Arguments address counterarguments with rebuttals and appeal to logos, ethos and pathos.", "Narrative tells a story; descriptive paints a picture; expository explains; persuasive convinces.", "Know your audience (who's reading) and purpose (inform, persuade, entertain).", "Nonfiction forms: biography, autobiography, memoir, news report, editorial, review.", "Tone is the writer's attitude; match formality to the situation."], ["Which is a strong thesis?", "\"Bikes have two wheels\" is just a fact", "\"Cities should expand bike lanes to cut traffic\" takes a debatable position", "Answer: the bike-lane claim"], "A thesis should be specific enough that someone could disagree."], "wri8": ["Parallel structure keeps items in the same grammatical form; good modifiers sit next to what they describe. Good style is clear, concise and precise.", ["Parallel: \"hiking, swimming and biking,\" not \"hiking, swimming and to bike.\"", "Paired constructions need parallel halves: not only fast but also cheap.", "Dangling modifier: \"Walking home, the rain started\" (the rain wasn't walking).", "Misplaced modifier: put \"only,\" \"almost\" and \"just\" right before the word they modify.", "Cut wordy phrases: \"due to the fact that\" → because; \"in order to\" → to.", "Remove redundancy (free gift, past history) and clichés.", "Prefer strong, specific verbs and active voice: \"analyze\" rather than \"make an analysis of.\"", "Diction is word choice; syntax is word order; match both to your audience."], ["Fix \"He likes to swim and running.\"", "One item is an infinitive, the other a gerund", "Make both gerunds", "Answer: He likes swimming and running."], "Read each list item right after the shared start: \"He likes swimming / He likes running.\""], "wri10": ["Research writing uses sources honestly and gives them credit.", ["Primary sources are first-hand (diaries, data); secondary sources analyze them (textbooks, articles).", "Credible sources are current, accurate and authoritative (the CRAAP test).", "Quote exact words in quotation marks; paraphrase in your own words; always cite both.", "MLA: Works Cited with (Author page). APA: References with (Author, year)."], ["Is a paraphrase without citation okay?", "A paraphrase still uses someone else's idea", "Using ideas without credit is plagiarism", "Answer: no, it still needs a citation"], "Cite ideas, not just quotations."], "lit1": ["Every story is built from the same basic elements. Point of view is the perspective a story is told from.", ["Characters (protagonist vs. antagonist), setting (time and place) and conflict (the central problem).", "Plot: exposition → rising action → climax → falling action → resolution.", "Conflict can be external (vs. nature, society, another person) or internal (vs. self).", "Theme is the message; mood is the feeling the reader gets.", "First person: a character narrates with \"I.\"", "Second person: the reader is \"you\" (rare).", "Third person limited: one character's thoughts. Omniscient: everyone's thoughts. Objective: no thoughts at all.", "Unreliable narrators can't be fully trusted; the narrator isn't the author."], ["Where is the climax in a plot?", "Tension builds through the rising action", "The turning point of highest tension comes next", "Answer: the climax, just before the falling action"], "Theme is a full idea (\"Greed destroys trust\"), not one word."], "lit2": ["Figurative language goes beyond literal meaning to create images and effects. Literary devices are techniques authors use to shape meaning and keep readers engaged.", ["Simile (like/as) vs. metaphor (direct comparison).", "Personification gives human traits; hyperbole exaggerates; understatement downplays.", "Sound devices: alliteration (first consonants), assonance (vowels), onomatopoeia (sound words).", "Advanced: oxymoron, paradox, synecdoche (part for whole), metonymy (related thing), apostrophe.", "Foreshadowing hints at the future; flashback returns to the past.", "Irony: verbal (saying the opposite), situational (unexpected outcome), dramatic (the audience knows more).", "Symbols stand for ideas; imagery appeals to the senses; allusion references known works.", "Drama: monologue (to others), soliloquy (alone), aside (to the audience)."], ["\"Time is a thief\": simile or metaphor?", "It compares time to a thief", "There's no \"like\" or \"as\"", "Answer: metaphor"], "Simile = Similar, with like/as."], "lit3": ["Poetry uses lines, stanzas, sound and rhythm to create meaning.", ["Forms: haiku (5-7-5), limerick (AABBA), sonnet (14 lines), free verse (no set rhyme or meter).", "Stanzas: couplet (2 lines), tercet (3), quatrain (4).", "Meter: iamb (da-DUM), trochee (DUM-da); iambic pentameter = 5 iambs per line.", "Blank verse is unrhymed iambic pentameter; enjambment runs lines on; a caesura is a mid-line pause."], ["How many syllables are in a haiku?", "Line 1: 5, line 2: 7, line 3: 5", "5 + 7 + 5", "Answer: 17"], "Tap the beat: \"to BE or NOT to BE\" is iambic."], "lit6": ["Genres group works by form and content.", ["Fiction (made up) vs. nonfiction (true).", "Fiction genres: fantasy, science fiction, historical fiction, mystery, dystopian, fable, myth.", "Drama: tragedy (the hero falls through a hamartia, or flaw) and comedy (a happy ending).", "Novel types: epistolary (letters), Bildungsroman (coming of age), picaresque, Gothic."], ["What do you call a coming-of-age novel?", "It follows a young person growing up", "German literary term: Bildung = education/formation", "Answer: Bildungsroman"], "Catharsis is the audience's emotional release at the end of a tragedy."], "lit7": ["William Shakespeare (1564–1616) wrote about 37 plays and 154 sonnets.", ["Tragedies: Romeo and Juliet, Hamlet, Macbeth, Othello, King Lear, Julius Caesar.", "Comedies: A Midsummer Night's Dream, Twelfth Night, Much Ado About Nothing.", "Romances: The Tempest. Histories: Henry V, Richard III.", "His plays were performed at the Globe Theatre in London; he was born in Stratford-upon-Avon."], ["Which play features three witches?", "Witches prophesy that a Scottish general will be king", "He and his wife then plot a murder", "Answer: Macbeth"], "Tragedies end in death; comedies end in marriage."], "lit8": ["Classic novels from Britain and around the world have shaped literature.", ["Britain: Austen (Pride and Prejudice), Dickens (Oliver Twist), Mary Shelley (Frankenstein), the Brontës.", "20th century: Orwell (1984), Huxley (Brave New World), Woolf, Joyce, Tolkien.", "Russia: Tolstoy (War and Peace), Dostoevsky (Crime and Punishment).", "World: Cervantes (Don Quixote), Hugo (Les Misérables), Kafka, García Márquez, Achebe (Things Fall Apart)."], ["Who wrote Jane Eyre?", "It's one of the Brontë sisters", "Charlotte wrote Jane Eyre; Emily wrote Wuthering Heights", "Answer: Charlotte Brontë"], "Charlotte → Jane Eyre; Emily → Wuthering Heights."], "lit9": ["American literature ranges from 19th-century classics to modern masterpieces.", ["1800s: Hawthorne (The Scarlet Letter), Melville (Moby-Dick), Poe, Twain, Whitman, Dickinson, Thoreau.", "1920s–1950s: Fitzgerald (The Great Gatsby), Hemingway, Steinbeck, Faulkner, Salinger.", "Harlem Renaissance: Langston Hughes, Zora Neale Hurston.", "Later: Harper Lee, Bradbury, Vonnegut, Toni Morrison, Maya Angelou."], ["Who wrote The Grapes of Wrath?", "It's a Depression-era novel about Dust Bowl migrants", "Its author also wrote Of Mice and Men", "Answer: John Steinbeck"], "Link each author to one famous book first, then add more."], "lit10": ["Myths and epics are some of the oldest stories, and they're still referenced everywhere.", ["Greek heroes: Odysseus (Odyssey), Achilles (Iliad), Hercules, Perseus, Theseus, Jason.", "Epics: Gilgamesh (Mesopotamia), the Iliad and Odyssey (Homer), the Aeneid (Virgil), Beowulf (Old English).", "World classics: One Thousand and One Nights, the Ramayana, the Shahnameh, The Tale of Genji.", "Many phrases come from myths: Achilles' heel, Pandora's box, a Trojan horse."], ["What is an \"Achilles' heel\"?", "Achilles was nearly invincible", "His only weak spot was his heel", "Answer: a single fatal weakness"], "Homer → Iliad (war) and Odyssey (journey home)."], "voc0": ["Math, science and history each use special words with exact meanings. Knowing them makes every other subject easier.", ["Read the whole definition before looking at the choices.", "Look for word parts you know: \"bi-\" means two, \"photo\" means light, \"-ology\" means the study of.", "Watch the type of word: a definition that starts with \"to\" describes an action (a verb).", "When a question names a subject (\"In science…\"), think about how that subject uses the word."], ["Which word means \"a closed path that electricity flows through\"?", "A path that goes all the way around is a loop", "Electricity needs a complete loop to flow", "Answer: circuit"], "Try using the word in a sentence. If the sentence makes sense with the definition, you've got it."]});
            const escH = t => String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            function openHelp() {
                const d = problem && problem.d; if (!d) return;
                const h = HELP[d.id], tp = topicById(d.topic);
                $("helpKicker").textContent = `${tp ? tp.name + " \u00b7 " : ""}How it works`;
                $("helpTitle").textContent = `${d.symbol} ${d.name}`;
                if (!h) { $("helpBody").innerHTML = `<p class="help-intro">${escH(d.desc)}</p>`; }
                else {
                    const [intro, ideas, ex, tip] = h, steps = ex.slice(1).filter(Boolean);
                    $("helpBody").innerHTML = `<p class="help-intro">${escH(intro)}</p><div class="help-sec">Key ideas</div><ul class="help-list">${ideas.map(i => `<li>${escH(i)}</li>`).join("")}</ul>`
                        + `<div class="help-sec">Example</div><div class="help-ex"><div class="ex-q">${escH(ex[0])}</div>${steps.map(t => `<div class="ex-s">${escH(t)}</div>`).join("")}</div>`
                        + (tip ? `<div class="help-tip">\ud83d\udca1 ${escH(tip)}</div>` : "");
                }
                $("helpOverlay").hidden = false; $("helpOk").focus();
            }
            function closeHelp() { $("helpOverlay").hidden = true; }
            $("infoBtn").onclick = openHelp; $("helpClose").onclick = closeHelp; $("helpOk").onclick = closeHelp;
            $("helpOverlay").addEventListener("click", e => { if (e.target === $("helpOverlay")) closeHelp(); });
