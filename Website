                const waits = typeof st.wait === "function" ? st.wait() : !!(st.wait || st.waitFor);
                $("tutTitle").textContent = st.title; $("tutText").textContent = typeof st.text === "function" ? st.text() : st.text;
                { const shown = tut.steps.filter(x => !(x.skip && x.skip())); $("tutStepNo").textContent = shown.length > 1 ? `${shown.indexOf(st) + 1} / ${shown.length}` : ""; }
                $("tutNext").hidden = waits; $("tutWait").hidden = !waits; $("tutWait").textContent = st.waitFor ? "Do it to continue" : "Answer to continue"; $("tutNext").textContent = tut.i === tut.steps.length - 1 ? "Got it!" : "Next";
                $("tutSkip").hidden = tut.steps.length === 1 || tut.i === tut.steps.length - 1;
                $("tutWrap").hidden = false;
                const el = st.el && st.el(); if (el && el.offsetParent !== null && getComputedStyle(el).position !== "fixed" && !el.closest(".m-nav, .m-topbar")) el.scrollIntoView({ block: "center", behavior: "smooth" });
                requestAnimationFrame(tutLayout);
            }
            function tutStart(steps) { closeGameMenu(); if (typeof closeToolMenu === "function") closeToolMenu(); if (isMobile()) { mSheet = ""; setMobileView("main"); } tut.on = true; tut.i = 0; tut.steps = steps; tutShow(); clearInterval(tut.timer); tut.timer = setInterval(tutLayout, 400); }
            function tutNext() { if (!tut.on) return; const st = tut.steps[tut.i]; if (st && st.onNext) st.onNext(); tut.i++; tutShow(); }
            function tutEnd() {
                const wasMain = tut.steps === TUT_STEPS; tut.on = false; clearInterval(tut.timer); $("tutWrap").hidden = true;
                state.tut = state.tut || {}; if (wasMain) state.tut.main = 1; else state.tut.shop = 1; save();
            }
            const anyLevel10 = () => [...SUBJECTS.map(x => x.id), "plinko", "wheel", "dig"].some(id => levelOf(id) >= SHOP_LEVEL);
            $("tutNext").onclick = tutNext;
            $("tutSkip").onclick = tutEnd;
            $("repeatTutorial").onclick = () => { state.tut = { main: 0, shop: anyLevel10() ? 1 : 0 }; tutStart(TUT_STEPS); };
            addEventListener("resize", tutLayout); addEventListener("scroll", tutLayout, true);
            setInterval(() => { if (!tut.on && state.tut && state.tut.main && !state.tut.shop && anyLevel10() && !document.hidden) tutStart(TUT_SHOP); }, 1500);
            load(); const bootAway = state.awaySince || state.lastSeen; migrateSave(); if (!state.autoSpinMig) { state.autoSpinEnabled = true; state.autoSpinMig = 1; } if (!state.autoDropMig) { state.autoDropEnabled = true; state.autoDropMig = 1; } resolveWheelPending(); renderAll(); resizeCanvas(); nextProblem(); setInterval(save, 10000); tickRewards(); renderBoostBar(); applyMobile(); catchUpAway(bootAway); renderBgBadges();
            if (!state.tut) state.tut = { main: (state.solved || 0) > 0 ? 1 : 0, shop: anyLevel10() ? 1 : 0 };   // existing players skip the intro
            if (!state.tut.main) setTimeout(() => tutStart(TUT_STEPS), 600);
        })();
